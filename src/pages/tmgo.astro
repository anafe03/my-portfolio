---
// src/pages/tmgo.astro — TM Go architecture case study
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="TM Go architecture case study by Austin Nafe — the engineering decisions behind an AI agent trusted with real data, and its scaling path.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:title" content="TM Go — Architecture Case Study">
  <meta property="og:description" content="Constraining an agent so it could be trusted with real data — the decisions, the reliability, and how it scales.">
  <meta property="og:image" content="/profile.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <title>TM Go — Architecture Case Study · Austin Nafe</title>
  <style is:global>
  :root {
    --bg: #ffffff;
    --alt: #f7f8fa;
    --ink: #14161d;
    --text: #363b4d;
    --muted: #6a7186;
    --faint: #9aa1b2;
    --line: #e6e8ee;
    --line-soft: #eef0f4;
    --accent: #1d4e89;
    --accent-2: #2e6fb8;
    --accent-tint: #eef4fb;
    --red: #b23a3a;
    --red-tint: #fbefef;
    --green: #1f7a5a;
    --green-tint: #ecf6f1;
    --amber-ink: #8a6300;
    --amber-tint: #fbf3e2;
    --shadow: 0 1px 2px rgba(20,22,29,.04), 0 6px 20px rgba(20,22,29,.05);
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --rail-w: 264px; --maxw: 820px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg); color: var(--text); font-family: var(--sans);
    font-size: 17px; line-height: 1.62; -webkit-font-smoothing: antialiased; letter-spacing: -0.002em;
  }
  ::selection { background: #cfe0f4; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-2); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

  .shell { display: flex; }
  .rail {
    position: sticky; top: 0; align-self: flex-start; width: var(--rail-w); height: 100vh; flex-shrink: 0;
    padding: 34px 26px; border-right: 1px solid var(--line);
    display: flex; flex-direction: column; gap: 2px; background: var(--bg); z-index: 20;
  }
  .rail-brand { padding-bottom: 6px; }
  .rail-brand .nm { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .rail-brand b { color: var(--ink); font-weight: 700; font-size: 18px; display: block; margin-top: 4px; letter-spacing: -0.01em; }
  .rail-brand i { color: var(--muted); font-style: normal; font-size: 12.5px; display: block; margin-top: 2px; }
  .rail-list { list-style: none; margin-top: 22px; display: flex; flex-direction: column; gap: 1px; overflow-y: auto; }
  .rail-item {
    display: flex; align-items: baseline; gap: 11px; font-size: 13.5px; color: var(--muted);
    padding: 7px 11px; border-radius: 6px; cursor: pointer; transition: color .15s, background .15s;
    border-left: 2px solid transparent; width: 100%; text-align: left; background: none;
  }
  .rail-item:hover { color: var(--ink); background: var(--alt); }
  .rail-item .rn { color: var(--faint); font-size: 11px; width: 20px; flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .rail-item.active { color: var(--accent); background: var(--accent-tint); border-left-color: var(--accent); font-weight: 600; }
  .rail-item.active .rn { color: var(--accent); }
  .rail-div { margin-top: 16px; margin-bottom: 4px; padding: 0 11px; font-size: 10.5px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--faint); font-weight: 600; }
  .rail-foot { margin-top: auto; font-size: 12.5px; color: var(--muted); line-height: 1.9; padding-top: 16px; border-top: 1px solid var(--line-soft); }

  main { flex: 1; min-width: 0; }
  .panel { padding: 74px clamp(24px, 6vw, 100px); border-bottom: 1px solid var(--line-soft); position: relative; }
  .panel.alt { background: var(--alt); }
  .panel-inner { width: 100%; max-width: var(--maxw); margin: 0 auto; }

  .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
  .eyebrow .sec { color: var(--faint); }

  h1 { font-size: clamp(2.4rem, 5vw, 3.7rem); line-height: 1.05; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); text-wrap: balance; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1.12; font-weight: 700; letter-spacing: -0.024em; color: var(--ink); text-wrap: balance; }
  h3 { font-size: 1.02rem; font-weight: 650; color: var(--ink); letter-spacing: -0.008em; }
  .lede { font-size: clamp(1.05rem, 1.6vw, 1.22rem); color: var(--muted); max-width: 64ch; margin-top: 18px; line-height: 1.6; }
  .lede strong, p.body strong { color: var(--ink); font-weight: 600; }
  p.body { color: var(--text); max-width: 66ch; margin-top: 16px; }
  em { font-style: italic; color: var(--ink); }
  code { font-family: var(--mono); font-size: 0.84em; background: var(--alt); border: 1px solid var(--line); padding: 1px 5px; border-radius: 4px; color: var(--accent); }

  .reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.in { opacity: 1; transform: none; }

  /* hero */
  #hero { padding-top: 90px; padding-bottom: 84px; }
  .hero-kicker { font-size: 12.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 22px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .hero-kicker .live { display: inline-flex; align-items: center; gap: 7px; color: var(--green); }
  .hero-kicker .live::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
  .hero-sub { font-size: clamp(1.15rem, 2vw, 1.4rem); color: var(--muted); max-width: 60ch; margin-top: 22px; line-height: 1.55; }
  .hero-sub strong { color: var(--ink); font-weight: 600; }
  .hero-cta { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .btn { font-size: 14px; font-weight: 600; padding: 11px 20px; border-radius: 8px; border: 1px solid var(--line); color: var(--ink); cursor: pointer; transition: all .15s; background: var(--bg); display: inline-flex; align-items: center; gap: 8px; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { background: var(--accent-2); border-color: var(--accent-2); }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn.primary:hover { color: #fff; }

  /* executive summary strip */
  .exec { margin-top: 44px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
  .exec .cell { padding: 20px 22px; border-right: 1px solid var(--line-soft); }
  .exec .cell:last-child { border-right: none; }
  .exec .cell .n { font-size: 1.5rem; font-weight: 700; color: var(--accent); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .exec .cell .l { font-size: 12.5px; color: var(--muted); margin-top: 5px; line-height: 1.4; }

  /* stack table */
  .spec { margin-top: 28px; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
  .spec .row { display: grid; grid-template-columns: 160px 1fr; gap: 18px; padding: 14px 22px; border-bottom: 1px solid var(--line-soft); font-size: 0.96rem; }
  .spec .row:last-child { border-bottom: none; }
  .spec .row:nth-child(even) { background: var(--alt); }
  .spec .k { font-weight: 600; color: var(--ink); font-size: 0.9rem; }
  .spec .v { color: var(--text); }
  .spec .v b { color: var(--ink); font-weight: 600; }
  .honest { margin-top: 18px; font-size: 0.95rem; color: var(--text); background: var(--amber-tint); border: 1px solid #eeddb8; border-radius: 10px; padding: 14px 18px; }
  .honest b { color: var(--amber-ink); }

  /* decision: problem + contrast + principle */
  .problem { margin-top: 22px; font-size: 1.06rem; color: var(--ink); background: var(--accent-tint); border-radius: 10px; padding: 18px 22px; max-width: 70ch; }
  .problem .pl { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 8px; }
  .contrast { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 24px; }
  .side { border-radius: 12px; padding: 22px; border: 1px solid var(--line); background: var(--bg); box-shadow: var(--shadow); }
  .side.naive { border-top: 3px solid var(--red); }
  .side.built { border-top: 3px solid var(--green); }
  .side .st { font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 13px; }
  .side.naive .st { color: var(--red); } .side.built .st { color: var(--green); }
  .side p { color: var(--text); font-size: 0.97rem; } .side p + p { margin-top: 11px; }
  .side p b { color: var(--ink); }
  .principle { margin-top: 24px; font-size: 1.1rem; line-height: 1.5; color: var(--ink); border-left: 3px solid var(--accent); padding: 4px 0 4px 22px; font-weight: 500; }
  .principle .wl { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 8px; }

  /* feature cards */
  .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 26px; }
  .feat { background: var(--bg); border: 1px solid var(--line); border-radius: 11px; padding: 20px; box-shadow: var(--shadow); }
  .feat h3 { margin-bottom: 8px; }
  .feat p { color: var(--text); font-size: 0.93rem; }

  /* metric tiles */
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap: 14px; margin-top: 26px; }
  .metric { background: var(--bg); border: 1px solid var(--line); border-radius: 11px; padding: 18px 20px; box-shadow: var(--shadow); }
  .metric .mv { font-size: 1.4rem; font-weight: 700; color: var(--ink); letter-spacing: -0.02em; }
  .metric .mv.green { color: var(--green); }
  .metric .ml { font-size: 12.5px; color: var(--muted); margin-top: 5px; }

  /* scale roadmap */
  .road { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 28px; }
  .road .col { border: 1px solid var(--line); border-radius: 12px; padding: 22px; background: var(--bg); box-shadow: var(--shadow); }
  .road .cl { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 16px; }
  .road .breaks .cl { color: var(--red); } .road .target .cl { color: var(--accent); }
  .road ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .road li { font-size: 0.96rem; color: var(--text); padding-left: 22px; position: relative; }
  .road li::before { position: absolute; left: 0; top: 1px; font-weight: 700; }
  .road .breaks li::before { content: "—"; color: var(--red); }
  .road .target li::before { content: "→"; color: var(--accent); }
  .road li b { color: var(--ink); font-weight: 600; }
  .road li .note { color: var(--muted); }
  .carry { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 20px; }
  .carry div { font-size: 0.93rem; line-height: 1.65; border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; color: var(--text); background: var(--alt); }
  .carry .cf b { color: var(--green); } .carry .rd b { color: var(--amber-ink); }

  /* summary */
  .quote { margin-top: 24px; font-size: 1.12rem; line-height: 1.7; color: var(--text); max-width: 70ch; }
  .quote strong { color: var(--ink); font-weight: 600; }
  .oneline { margin-top: 26px; background: var(--accent-tint); border-radius: 12px; padding: 22px 24px; font-size: 1.08rem; color: var(--ink); max-width: 70ch; }
  .oneline .ql { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 10px; }
  .oneline i { font-style: italic; }
  .close-links { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }

  .progress { position: fixed; top: 0; left: var(--rail-w); right: 0; height: 3px; background: var(--line-soft); z-index: 40; }
  .progress i { display: block; height: 100%; width: 0%; background: var(--accent); transition: width .1s linear; }

  @media (max-width: 920px) {
    .rail { display: none; } .progress { left: 0; } main { width: 100%; }
    .contrast, .road, .carry { grid-template-columns: 1fr; }
    .exec { grid-template-columns: repeat(2, 1fr); } .exec .cell:nth-child(2) { border-right: none; }
    .spec .row { grid-template-columns: 1fr; gap: 4px; }
    .panel { padding: 56px 22px; } body { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { * { animation-duration: .001ms !important; transition-duration: .001ms !important; } html { scroll-behavior: auto; } .reveal { opacity: 1; transform: none; } }
</style>
</head>
<body>


<div class="progress"><i id="progBar"></i></div>

<div class="shell">
  <nav class="rail" aria-label="Contents">
    <div class="rail-brand"><span class="nm">Austin Nafe</span><b>TM Go</b><i>Architecture case study</i></div>
    <ul class="rail-list" id="railList">
      <li><button class="rail-item" data-goto="hero"><span class="rn">00</span> Overview</button></li>
      <li><button class="rail-item" data-goto="stack"><span class="rn">01</span> System &amp; stack</button></li>
      <li class="rail-div">Key engineering decisions</li>
      <li><button class="rail-item" data-goto="d1"><span class="rn">01</span> Agent design</button></li>
      <li><button class="rail-item" data-goto="d2"><span class="rn">02</span> State management</button></li>
      <li><button class="rail-item" data-goto="d3"><span class="rn">03</span> Inbox modeling</button></li>
      <li><button class="rail-item" data-goto="d4"><span class="rn">04</span> Reliability</button></li>
      <li><button class="rail-item" data-goto="d5"><span class="rn">05</span> Evaluation</button></li>
      <li><button class="rail-item" data-goto="d6"><span class="rn">06</span> Data model</button></li>
      <li><button class="rail-item" data-goto="d7"><span class="rn">07</span> Delivery</button></li>
      <li class="rail-div">Forward</li>
      <li><button class="rail-item" data-goto="scale"><span class="rn">02</span> Scaling path</button></li>
      <li><button class="rail-item" data-goto="talk"><span class="rn">03</span> Summary</button></li>
    </ul>
    <div class="rail-foot"><a href="/">← Back to portfolio</a><br><a href="/intelligence">Austin's Intelligence</a><br><a href="/RESUME_2026.pdf">Résumé (PDF)</a></div>
  </nav>

  <main>
    <!-- OVERVIEW -->
    <section class="panel" id="hero" data-rung="hero">
      <div class="panel-inner">
        <div class="hero-kicker">
          <span>Architecture Case Study</span>
          <span class="live">Live in production</span>
        </div>
        <h1>TM Go</h1>
        <p class="hero-sub">An autonomous tour-management agent for independent bands — it advances shows over email and SMS, reads free-form venue replies, extracts the logistics, and keeps each tour's records in sync. This document covers the system, the <strong>seven engineering decisions</strong> that made it safe to write to a band's real data, and how it scales.</p>
        <div class="hero-cta">
          <a class="btn primary" href="https://toursync-deploy.vercel.app" target="_blank" rel="noopener">View the live application</a>
          <button class="btn" data-goto="stack">System overview</button>
          <a class="btn" href="/RESUME_2026.pdf">Résumé</a>
        </div>
        <div class="exec">
          <div class="cell"><div class="n">LangGraph</div><div class="l">Bounded state-machine agent, not an open loop</div></div>
          <div class="cell"><div class="n">100%</div><div class="l">Live field-extraction accuracy; CI gate at 80%</div></div>
          <div class="cell"><div class="n">2</div><div class="l">LLM providers with automatic failover</div></div>
          <div class="cell"><div class="n">59</div><div class="l">API routes; Pydantic-validated, containerized</div></div>
        </div>
      </div>
    </section>

    <!-- STACK -->
    <section class="panel alt" id="stack" data-rung="stack">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">01</span> System &amp; stack</div>
        <h2>System overview</h2>
        <p class="lede">The real deployed system, with prototype shortcuts named as such rather than hidden.</p>
        <div class="spec">
          <div class="row"><span class="k">Frontend</span><span class="v"><b>React + Vite</b>, deployed on Vercel</span></div>
          <div class="row"><span class="k">API</span><span class="v"><b>Starlette → FastAPI</b> — 59 routes; Pydantic-validated AI endpoints with OpenAPI docs</span></div>
          <div class="row"><span class="k">Agent core</span><span class="v"><b>LangGraph StateGraph</b> — a router dispatching to explicit, deterministic pipelines</span></div>
          <div class="row"><span class="k">LLM</span><span class="v">LangChain <code>init_chat_model</code> — OpenAI primary, <b>Anthropic failover</b></span></div>
          <div class="row"><span class="k">SMS</span><span class="v">FastAPI + <b>Twilio</b> webhook</span></div>
          <div class="row"><span class="k">Data</span><span class="v"><b>Google Sheets</b> (per-band system-of-record) + <b>Supabase</b> (auth, storage, AI telemetry)</span></div>
          <div class="row"><span class="k">Scheduler</span><span class="v"><b>Railway</b> cron worker for reminders</span></div>
          <div class="row"><span class="k">Reliability</span><span class="v"><code>traced_llm</code> observability + closed-loop evaluation + <code>/api/ai-health</code> dashboard</span></div>
          <div class="row"><span class="k">Delivery</span><span class="v"><b>GitHub Actions</b> CI (build · lint · eval gate) + Docker; Vercel/Render auto-deploy</span></div>
        </div>
        <div class="honest"><b>Deliberately not included:</b> billing (no Stripe yet). The API was Starlette, upgraded to FastAPI specifically for the AI endpoints. Naming what isn't there is part of the point.</div>
      </div>
    </section>

    <!-- D1 -->
    <section class="panel" id="d1" data-rung="d1">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 01</span> Agent design</div>
        <h2>A bounded state-machine agent</h2>
        <div class="problem"><span class="pl">The problem</span>Advancing a show is a multi-step, correctness-sensitive workflow. Writing an incorrect load-in time into a band's real tour data is worse than writing nothing at all — so the agent's behavior has to be predictable.</div>
        <div class="contrast">
          <div class="side naive">
            <div class="st">Naive approach</div>
            <p>A <b>ReAct agent</b> that reasons and picks tools freely each turn.</p>
            <p>It re-plans every turn, its tool order is non-deterministic, and it can skip steps. Effective in a demo; unacceptable for a workflow that writes to real data.</p>
          </div>
          <div class="side built">
            <div class="st">What I shipped</div>
            <p>A hand-authored <b>LangGraph StateGraph</b>. A router node classifies intent once, then dispatches to explicit pipelines (e.g. <code>advance</code>: read venue → draft email).</p>
            <p>The LLM only drafts prose and parses free text into JSON. Routing, sheet I/O, validation, and email transport are <b>deterministic Python</b>.</p>
          </div>
        </div>
        <div class="principle"><span class="wl">Principle</span>Determinism where correctness matters; the model only where language matters. The right move was not a more capable agent — it was a more constrained one.</div>
      </div>
    </section>

    <!-- D2 -->
    <section class="panel alt" id="d2" data-rung="d2">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 02</span> State management</div>
        <h2>Deriving state rather than storing it</h2>
        <div class="problem"><span class="pl">The problem</span>The interface must always show the correct "whose turn is it" across dozens of concurrent venue threads.</div>
        <div class="contrast">
          <div class="side naive">
            <div class="st">Naive approach</div>
            <p>A stored <code>status</code> column on each thread.</p>
            <p>It drifts out of sync: a reply arrives but the column still reads <code>sent</code>, so the interface reports the wrong state with full confidence.</p>
          </div>
          <div class="side built">
            <div class="st">What I shipped</div>
            <p>"Whose turn" is computed as a <b>pure function</b> of <code>(messages, sheet facts)</code> — derived, never stored.</p>
            <p>A derived value cannot drift from the source of truth. A stored copy eventually always does.</p>
          </div>
        </div>
        <div class="principle"><span class="wl">Principle</span>If a value can be recomputed from the source of truth, deriving it removes an entire class of consistency bugs.</div>
      </div>
    </section>

    <!-- D3 -->
    <section class="panel" id="d3" data-rung="d3">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 03</span> Inbox modeling</div>
        <h2>The inbox as a workflow queue</h2>
        <div class="problem"><span class="pl">The problem</span>Send outreach, receive replies, convert replies into structured facts, and generate the next email — across dozens of venue threads at once.</div>
        <div class="contrast">
          <div class="side naive">
            <div class="st">Naive approach</div>
            <p>Build an email client. That merges three representations of one conversation: <b>live IMAP, logged sends, and optimistic UI state</b>.</p>
            <p>They disagree — messages reorder, duplicate, and deleted ones reappear.</p>
          </div>
          <div class="side built">
            <div class="st">What I shipped</div>
            <p>Reframed as a <b>queue keyed on the show</b>, not the message. Each cycle reconstructs "what to ask" from <code>(questions enabled) − (facts on sheet)</code>.</p>
            <p>The system never relies on remembered conversation state — it recomputes what remains outstanding.</p>
          </div>
        </div>
        <div class="principle"><span class="wl">Principle</span>Collapsing three sources of truth into one derived view eliminated the entire ordering-and-duplication bug class.</div>
      </div>
    </section>

    <!-- D4 -->
    <section class="panel alt" id="d4" data-rung="d4">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 04</span> Reliability</div>
        <h2>Reliability as a design requirement</h2>
        <p class="lede">Each of these exists because a specific failure would place an incorrect fact in front of a band on tour. They are requirements, not polish.</p>
        <div class="feat-grid">
          <div class="feat"><h3>Provider failover</h3><p>OpenAI primary, <b>Anthropic on failure</b>. A single provider's outage is not the product's outage.</p></div>
          <div class="feat"><h3>Tolerant parsing</h3><p>JSON extraction survives code fences and stray prose, so a formatting quirk doesn't fail a valid extraction.</p></div>
          <div class="feat"><h3>Human-in-the-loop</h3><p>Extractions are reviewed before reaching the sheet. Gap-fill only — a confirmed value is never overwritten.</p></div>
          <div class="feat"><h3>Validated inputs</h3><p>A malformed request returns a clean <code>422</code>, not a deep <code>KeyError</code> several calls into the stack.</p></div>
        </div>
      </div>
    </section>

    <!-- D5 -->
    <section class="panel" id="d5" data-rung="d5">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 05</span> Evaluation &amp; observability</div>
        <h2>Measuring correctness, and learning from corrections</h2>
        <div class="feat-grid">
          <div class="feat"><h3>Online — closed loop</h3><p>The human review step logs every accept, edit, and reject. Each correction is a labeled failure — a live dataset of the agent's weak points at <b>zero labeling cost</b>.</p></div>
          <div class="feat"><h3>Offline — CI gate</h3><p>A golden-set harness scores field extraction and <b>fails the build below 80%</b> accuracy (currently 100% live). A prompt or model change cannot merge if it regresses.</p></div>
          <div class="feat"><h3>One tracing seam</h3><p><code>traced_llm</code> is the single point every model call passes through — recording endpoint, model, latency, tokens, estimated cost, and whether failover fired.</p></div>
        </div>
        <div class="metrics">
          <div class="metric"><div class="mv green">100%</div><div class="ml">Live extraction accuracy</div></div>
          <div class="metric"><div class="mv">p50 / p95</div><div class="ml">Latency, tracked live</div></div>
          <div class="metric"><div class="mv">Cost / call</div><div class="ml">Per-request spend</div></div>
          <div class="metric"><div class="mv">Failover %</div><div class="ml">Provider health</div></div>
        </div>
        <div class="principle"><span class="wl">In one sentence</span>The agent is instrumented end to end — per-call cost, latency, and failures are visible live, and every human correction becomes labeled evaluation data that gates deployment.</div>
      </div>
    </section>

    <!-- D6 -->
    <section class="panel alt" id="d6" data-rung="d6">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 06</span> Data model</div>
        <h2>A prototype data model with a defined ceiling</h2>
        <div class="contrast">
          <div class="side built">
            <div class="st" style="color:var(--accent)">Why it was the right call</div>
            <p>Google Sheets is each band's <b>system-of-record</b>. Bands can see their own data with <b>zero setup</b> — ideal for proving the workflow.</p>
          </div>
          <div class="side naive">
            <div class="st">Where it breaks</div>
            <p>It is also what breaks first at scale: <b>API quotas, no transactions, no concurrency guarantees</b>.</p>
            <p>I'm not presenting it as permanent — naming the ceiling is the point.</p>
          </div>
        </div>
        <div class="principle"><span class="wl">Principle</span>Selecting the right tool for the current stage — and stating exactly where it will fail before it does — is the engineering judgment, not a gap in it.</div>
      </div>
    </section>

    <!-- D7 -->
    <section class="panel" id="d7" data-rung="d7">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Decision 07</span> Delivery</div>
        <h2>Evaluation-gated continuous delivery</h2>
        <div class="feat-grid">
          <div class="feat"><h3>CI on every push</h3><p>GitHub Actions runs the frontend build, a real-error lint, and the <b>evaluation gate</b>. A regression in extraction accuracy blocks the merge.</p></div>
          <div class="feat"><h3>Automatic deploy</h3><p>A passing <code>main</code> deploys itself to Vercel and Render — no manual release step to forget.</p></div>
          <div class="feat"><h3>Containerized backend</h3><p>Docker packages the backend to run identically anywhere. This container is the unit a worker pool would replicate at scale.</p></div>
        </div>
        <div class="principle"><span class="wl">Why it matters</span>Because the backend is already containerized, moving to a worker pool is a deployment change, not a rewrite — the scaling path was designed in from the start.</div>
      </div>
    </section>

    <!-- SCALE -->
    <section class="panel alt" id="scale" data-rung="scale">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Forward · 02</span> Scaling path</div>
        <h2>Behavior at scale, and the planned evolution</h2>
        <p class="lede">Presented as a <strong>roadmap, not a current claim</strong>. The system is not running at this scale today — but identifying precisely what fails first, and why, is the substance of the question.</p>
        <div class="road">
          <div class="col breaks">
            <div class="cl">Breaks first at 100×</div>
            <ul>
              <li><b>Sheets as database</b> — quotas, no transactions</li>
              <li><b>IMAP polling</b> and cold starts</li>
              <li><b>Synchronous LLM calls</b> on the request path</li>
              <li>The <b>three-source inbox merge</b></li>
            </ul>
          </div>
          <div class="col target">
            <div class="cl">Target architecture</div>
            <ul>
              <li><b>Postgres</b> as system-of-record; Sheets becomes an export</li>
              <li><b>Queue + worker pool</b> for concurrent runs <span class="note">(the backend is already containerized for this)</span></li>
              <li><b>LLM gateway</b> — caching, the existing failover, and per-tenant budgets, built on the <code>traced_llm</code> seam</li>
              <li><b>Event-driven email</b> (Gmail API / webhooks) replacing polling</li>
              <li><b>Multi-tenant isolation</b>, with evaluation as a release gate</li>
            </ul>
          </div>
        </div>
        <div class="carry">
          <div class="cf"><b>Carry forward:</b> deterministic-first design, provider failover, human-in-the-loop review, and the observability seam. The foundations are sound.</div>
          <div class="rd"><b>Rebuild:</b> the storage model and the inbox's three-source flow — the prototype shortcuts that do not survive multi-tenant load, each for a reason I can state precisely.</div>
        </div>
      </div>
    </section>

    <!-- SUMMARY -->
    <section class="panel" id="talk" data-rung="talk">
      <div class="panel-inner reveal">
        <div class="eyebrow"><span class="sec">Forward · 03</span> Summary</div>
        <h2>Summary</h2>
        <p class="quote">TM Go is an autonomous tour-management agent for independent bands — advancing shows over email and SMS, drafting venue outreach, parsing free-form replies into structured logistics, and keeping each tour's records in sync. The central engineering decision was <strong>constraining the agent</strong>: a hand-authored LangGraph StateGraph replaces an open ReAct loop, with the model confined to drafting and parsing and all state, routing, and I/O implemented as deterministic code. It ships with production-reliability plumbing — provider failover, tolerant parsing, validated inputs, human-in-the-loop review — and a <strong>traced_llm observability layer that doubles as a closed-loop evaluation harness</strong>: every human correction becomes labeled data, and a CI gate blocks any change that reduces extraction accuracy.</p>
        <div class="oneline"><span class="ql">One-line version</span><i>"I constrained an agent so it could be trusted with real data, then instrumented it so that every human correction became evaluation data gating deployment."</i></div>
        <div class="close-links">
          <a class="btn primary" href="https://toursync-deploy.vercel.app" target="_blank" rel="noopener">View the live application</a>
          <a class="btn" href="/intelligence">Austin's Intelligence</a>
          <a class="btn" href="/RESUME_2026.pdf">Résumé</a>
          <a class="btn" href="mailto:austinnafe@aol.com">Contact</a>
        </div>
      </div>
    </section>
  </main>
</div>

<script is:inline>
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var reveals = [].slice.call(document.querySelectorAll('.reveal'));
  var ro = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }); }, { threshold: 0.1 });
  reveals.forEach(function (r) { ro.observe(r); });
  function revealNear(){ reveals.forEach(function(r){ var b=r.getBoundingClientRect(); if(b.top<innerHeight*1.1 && b.bottom>-50){ r.classList.add('in'); ro.unobserve(r);} }); }
  revealNear(); addEventListener('load', revealNear);

  var panels = [].slice.call(document.querySelectorAll('.panel'));
  var railItems = [].slice.call(document.querySelectorAll('.rail-item'));
  var order = ['hero','stack','d1','d2','d3','d4','d5','d6','d7','scale','talk'];
  var progBar = document.getElementById('progBar');
  function railFor(r){ return railItems.find(function(b){ return b.getAttribute('data-goto')===r; }); }
  var ao = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      var rung = e.target.getAttribute('data-rung'); var idx = order.indexOf(rung);
      railItems.forEach(function (b) { b.classList.remove('active');
        var bi = order.indexOf(b.getAttribute('data-goto'));
        if (bi>-1 && bi<idx) b.classList.add('done'); else b.classList.remove('done'); });
      var cur = railFor(rung); if (cur) cur.classList.add('active');
    });
  }, { threshold: 0.45 });
  panels.forEach(function (p) { ao.observe(p); });
  function updProg(){ var h=document.documentElement; var m=h.scrollHeight-h.clientHeight; progBar.style.width=(m>0?(h.scrollTop/m*100):0).toFixed(1)+'%'; }
  addEventListener('scroll', updProg, {passive:true}); updProg();

  function gotoRung(r){ var el=document.getElementById(r); if(el) el.scrollIntoView({behavior: reduce?'auto':'smooth', block:'start'}); }
  document.querySelectorAll('[data-goto]').forEach(function(b){ b.addEventListener('click', function(){ gotoRung(b.getAttribute('data-goto')); }); });
  function curIdx(){ var mid=scrollY+innerHeight*.5; for(var i=panels.length-1;i>=0;i--){ if(panels[i].offsetTop<=mid) return i; } return 0; }
  addEventListener('keydown', function(e){
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
    var i=curIdx();
    if(['ArrowDown','ArrowRight','PageDown'].indexOf(e.key)>-1){ e.preventDefault(); if(i<panels.length-1) panels[i+1].scrollIntoView({behavior:reduce?'auto':'smooth'}); }
    else if(['ArrowUp','ArrowLeft','PageUp'].indexOf(e.key)>-1){ e.preventDefault(); if(i>0) panels[i-1].scrollIntoView({behavior:reduce?'auto':'smooth'}); }
  });
})();
</script>

