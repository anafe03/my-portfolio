<script is:inline>
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var reveals = [].slice.call(document.querySelectorAll('.reveal'));
  var ro = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }); }, { threshold: 0.1 });
  reveals.forEach(function (r) { ro.observe(r); });
  function revealNear(){ reveals.forEach(function(r){ var b=r.getBoundingClientRect(); if(b.top<innerHeight*1.1 && b.bottom>-50){ r.classList.add('in'); ro.unobserve(r);} }); }
  revealNear(); addEventListener('load', revealNear);

  // Numbers count up when their tile first scrolls in. Only touches values that ARE numbers —
  // a tile reading "LangGraph" or "Weekly" is left alone rather than mangled into NaN.
  var NUM = /^([^\d\-]*)(\d+(?:,\d{3})*(?:\.\d+)?)(.*)$/;
  function countUp(el){
    var m = NUM.exec(el.textContent.trim());
    if (!m) return;
    var pre = m[1], post = m[3], raw = m[2].replace(/,/g, '');
    var end = parseFloat(raw), decimals = (raw.split('.')[1] || '').length;
    var grouped = m[2].indexOf(',') > -1;
    if (!isFinite(end) || end === 0) return;
    var t0 = null, dur = 900;
    function fmt(v){
      var s = v.toFixed(decimals);
      if (grouped) s = Number(s).toLocaleString('en-US', {minimumFractionDigits: decimals});
      return pre + s + post;
    }
    function frame(ts){
      if (t0 === null) t0 = ts;
      var p = Math.min(1, (ts - t0) / dur);
      p = 1 - Math.pow(1 - p, 3);                  // ease-out, lands soft
      el.textContent = fmt(end * p);
      if (p < 1) requestAnimationFrame(frame); else el.textContent = fmt(end);
    }
    el.textContent = fmt(0);
    requestAnimationFrame(frame);
  }
  if (!reduce) {
    var numbers = [].slice.call(document.querySelectorAll('.metric .mv, .exec .cell .n'));
    var no = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting) { countUp(e.target); no.unobserve(e.target); } });
    }, { threshold: 0.6 });
    numbers.forEach(function(n){ no.observe(n); });
  }

  var panels = [].slice.call(document.querySelectorAll('.panel'));
  var railItems = [].slice.call(document.querySelectorAll('.rail-item'));
  var order = ['hero','diagram','stack','d1','d2','d3','d4','d5','d6','d7','intel','breaks','cost','stateng','modelbreaks','evolve','scale','talk'];
  var progBar = document.getElementById('progBar');
  function railFor(r){ return railItems.find(function(b){ return b.getAttribute('data-goto')===r; }); }
  var ao = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      var rung = e.target.getAttribute('data-rung'); var idx = order.indexOf(rung);
      railItems.forEach(function (b) { b.classList.remove('active');
        var bi = order.indexOf(b.getAttribute('data-goto'));
        if (bi>-1 && bi<idx) b.classList.add('done'); else b.classList.remove('done'); });
      var cur = railFor(rung); if (cur) cur.classList.add('active');
    });
  }, { threshold: 0.45 });
  panels.forEach(function (p) { ao.observe(p); });
  function updProg(){ var h=document.documentElement; var m=h.scrollHeight-h.clientHeight; progBar.style.width=(m>0?(h.scrollTop/m*100):0).toFixed(1)+'%'; }
  addEventListener('scroll', updProg, {passive:true}); updProg();

  function gotoRung(r){ var el=document.getElementById(r); if(el) el.scrollIntoView({behavior: reduce?'auto':'smooth', block:'start'}); }
  document.querySelectorAll('[data-goto]').forEach(function(b){ b.addEventListener('click', function(){ gotoRung(b.getAttribute('data-goto')); }); });
  function curIdx(){ var mid=scrollY+innerHeight*.5; for(var i=panels.length-1;i>=0;i--){ if(panels[i].offsetTop<=mid) return i; } return 0; }
  addEventListener('keydown', function(e){
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
    var i=curIdx();
    if(['ArrowDown','ArrowRight','PageDown'].indexOf(e.key)>-1){ e.preventDefault(); if(i<panels.length-1) panels[i+1].scrollIntoView({behavior:reduce?'auto':'smooth'}); }
    else if(['ArrowUp','ArrowLeft','PageUp'].indexOf(e.key)>-1){ e.preventDefault(); if(i>0) panels[i-1].scrollIntoView({behavior:reduce?'auto':'smooth'}); }
  });
})();
</script>

