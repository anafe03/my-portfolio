  <script>
    // ─── Adventure / Creative data ───────────────────────────────────
    // Swap this for your real data later. Place IDs are the join key
    // between map pins and tracks/projects.
    interface Place {
      id: string;
      city: string;
      coords: [number, number];
      date: string;
      note: string;
      country?: string;
      current?: boolean;
      songs?: string[];
      projects?: string[];
      guide?: string;
      // Place-modal fields (all optional, fill at your pace or via Sheet later)
      photos?: string[];
      eat?: string;
      drink?: string;
      coffee?: string;
      move?: string;
      stay?: string;
      hiddenGem?: string;
      skip?: string;
      strangest?: string;
      verdict?: string;
    }
    interface Track {
      id: string;
      title: string;
      bpm?: number;
      musicalKey?: string;
      tags: string[];
      placeId?: string;
      soundcloudUrl?: string;
      status?: 'released' | 'unreleased' | 'sketch';
    }
    interface Video {
      id: string;
      title: string;
      date: string;
      youtubeId?: string;
    }

    // Ordered to match the Notion travel log "Big Bend Depart" → current.
    // Repeat visits to the same city consolidated into one pin.
    // ─── Google Sheets integration ─────────────────────────
    //
    // To swap the hardcoded places below for a live Google Sheet:
    //
    // 1. Make a sheet with these columns (header row, exact spelling):
    //    id · city · lat · lng · date · country · current · note · guide
    //    songs · projects · photos · eat · drink · coffee · move · stay
    //    hiddenGem · skip · strangest · verdict
    //
    // 2. File → Share → Publish to web → choose "Comma-separated values (.csv)"
    //    Copy the URL it gives you.
    //
    // 3. Paste it into PLACES_SHEET_CSV below. Save. Deploy.
    //    The site fetches it on load, falls back to hardcoded if it fails.
    //
    //    `current` is "true"/"1" for the pin to pulse coral.
    //    `songs` / `projects` / `photos` are comma-separated values within the cell.
    //
    // Live link to the Google Sheet "Austin Nafe — Travel Places".
    // Edits to the sheet appear on the site within seconds (no publish-to-web cache).
    // Requires the sheet to be shared "Anyone with the link → Viewer".
    const PLACES_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/15eRZCGCsDzij2rwgwFNinL5Jp6rWaOXwLuhFnS1XiTA/gviz/tq?tqx=out:csv';

    function parseCSVLine(line: string): string[] {
      const out: string[] = [];
      let cur = '';
      let inQuote = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (inQuote) {
          if (ch === '"' && line[i + 1] === '"') { cur += '"'; i++; }
          else if (ch === '"') inQuote = false;
          else cur += ch;
        } else {
          if (ch === ',') { out.push(cur); cur = ''; }
          else if (ch === '"') inQuote = true;
          else cur += ch;
        }
      }
      out.push(cur);
      return out;
    }

    function parseCSV(text: string): Record<string, string>[] {
      const lines = text.split(/\r?\n/).filter(l => l.trim());
      if (lines.length < 2) return [];
      const headers = parseCSVLine(lines[0]).map(h => h.trim());
      return lines.slice(1).map(line => {
        const vals = parseCSVLine(line);
        const row: Record<string, string> = {};
        headers.forEach((h, i) => row[h] = (vals[i] || '').trim());
        return row;
      });
    }

    function rowToPlace(row: Record<string, string>): Place | null {
      const lat = parseFloat(row.lat);
      const lng = parseFloat(row.lng);
      if (!row.id || isNaN(lat) || isNaN(lng)) return null;
      const splitList = (v: string) =>
        v ? v.split(',').map(s => s.trim()).filter(Boolean) : undefined;
      const truthy = (v: string) =>
        ['true', '1', 'yes', 'y'].includes((v || '').toLowerCase());
      return {
        id: row.id,
        city: row.city || row.id,
        coords: [lat, lng],
        date: row.date || '',
        note: row.note || '',
        country: row.country || undefined,
        current: truthy(row.current),
        guide: row.guide || undefined,
        songs: splitList(row.songs),
        projects: splitList(row.projects),
        photos: splitList(row.photos),
        eat: row.eat || undefined,
        drink: row.drink || undefined,
        coffee: row.coffee || undefined,
        move: row.move || undefined,
        stay: row.stay || undefined,
        hiddenGem: row.hiddenGem || undefined,
        skip: row.skip || undefined,
        strangest: row.strangest || undefined,
        verdict: row.verdict || undefined
      };
    }

    // Other data-source sheets (same live-link pattern; require "Anyone with link → Viewer")
    const FESTS_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1y43xMQ6rw2Xl65bN1tivP5qVqlTYgyxWfLa1hmqFgeA/gviz/tq?tqx=out:csv';
    const PARKS_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1edRZ9zCUnNHbr35_zaeSsFM5bSWl6h_Z6lLPTDNGw3M/gviz/tq?tqx=out:csv';
    const BUCKET_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1v9Oy0OFm_1zSEDABx7LG6SsJxP2s_5BPvW7FskOEqm8/gviz/tq?tqx=out:csv';
    const FINANCE_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1q83a0z3e8fmp31n9TXGbLn18sIzaytC1XwRm-K6DjSc/gviz/tq?tqx=out:csv';
    const ROUTINES_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1o6R_to7wVQAndivz3In-eirSRvWI6-enMbG-8BbO98o/gviz/tq?tqx=out:csv';
    const NOTEBOOK_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1DaOwzQCLs8GkE0U6zqUb1rfI-AmZLA84ooYTggGdPA0/gviz/tq?tqx=out:csv';
    const PHOTOS_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/1uGSQM-TjzktzoqBhSsgeh7peNZJNlkkKMqLnTnIzzO4/gviz/tq?tqx=out:csv';

    async function fetchSheet(url: string): Promise<Record<string, string>[]> {
      if (!url) return [];
      try {
        const res = await fetch(url, { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return parseCSV(await res.text());
      } catch (e) {
        console.warn('[sheet] fetch failed:', url, e);
        return [];
      }
    }

    function escapeHTML(s: string): string {
      return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    async function syncFestivals() {
      const rows = await fetchSheet(FESTS_SHEET_CSV);
      if (!rows.length) return;
      const list = document.querySelector('#fests .fests-list');
      if (!list) return;
      list.innerHTML = rows.map(r => {
        const photo = normalizePhotoUrl(r.photo || '');
        const tags = (r.tags || '').split(',').map(s => s.trim()).filter(Boolean);
        const photoHtml = photo
          ? `<div class="fest-photo"><img src="${escapeHTML(photo)}" alt="${escapeHTML(r.name || '')}" loading="lazy"></div>`
          : `<div class="fest-icon">${escapeHTML(r.icon || '🎶')}</div>`;
        return `
          <div class="fest">
            ${photoHtml}
            <div class="fest-body">
              <div class="fest-name">${escapeHTML(r.name || '')}</div>
              <div class="fest-meta">${escapeHTML([r.location, r.year].filter(Boolean).join(' · '))}</div>
              ${r.note ? `<p class="fest-note">${escapeHTML(r.note)}</p>` : ''}
              ${tags.length ? `<div class="fest-tags">${tags.map(t => `<span class="fest-tag">${escapeHTML(t)}</span>`).join('')}</div>` : ''}
            </div>
          </div>
        `;
      }).join('');
    }

    async function syncParks() {
      const rows = await fetchSheet(PARKS_SHEET_CSV);
      if (!rows.length) return;
      const grid = document.querySelector('#parks .parks-grid');
      if (!grid) return;
      grid.innerHTML = rows.map(r => `
        <div class="park">
          <span class="park-emoji">${escapeHTML(r.emoji || '🏞')}</span>
          <span class="park-name">${escapeHTML(r.name || '')}</span>
          <span class="park-year">${escapeHTML(r.year || '')}</span>
