      const sub = document.querySelector('#parks .section-header p');
      if (sub) sub.textContent = `${rows.length} of 63 · climbing slowly`;
    }

    interface BucketItem {
      priority: string;
      name: string;
      where: string;
      why: string;
      when: string;
      photo: string;
      details: string;
    }
    let bucketData: BucketItem[] = [];

    async function syncBucket() {
      const rows = await fetchSheet(BUCKET_SHEET_CSV);
      if (!rows.length) return;
      bucketData = rows.map(r => ({
        priority: r.priority || '',
        name: r.name || '',
        where: r.where || '',
        why: r.why || '',
        when: r.when || '',
        photo: normalizePhotoUrl(r.photo || ''),
        details: r.details || ''
      }));
      const grid = document.querySelector('#bucket .bucket-grid');
      if (!grid) return;
      grid.innerHTML = bucketData.map(b => {
        const padded = String(b.priority).padStart(2, '0');
        const photoHtml = b.photo
          ? `<img src="${escapeHTML(b.photo)}" alt="${escapeHTML(b.name)}" loading="lazy">`
          : `<span class="bucket-photo-emoji">🌍</span>`;
        return `
          <div class="bucket-card" data-priority="${escapeHTML(b.priority)}">
            <div class="bucket-photo">
              ${photoHtml}
              <span class="bucket-num">${escapeHTML(padded)}</span>
            </div>
            <div class="bucket-body">
              <h4>${escapeHTML(b.name)}</h4>
              <p class="bucket-where">${escapeHTML(b.where)}</p>
              <p class="bucket-why">${escapeHTML(b.why)}</p>
              <span class="bucket-when">${escapeHTML(b.when)}</span>
            </div>
          </div>
        `;
      }).join('');
      grid.querySelectorAll<HTMLElement>('.bucket-card').forEach(el => {
        el.addEventListener('click', () => {
          const p = el.dataset.priority;
          if (p !== undefined) openBucketModal(p);
        });
      });
    }

    function openBucketModal(priority: string) {
      const item = bucketData.find(b => b.priority === priority);
      if (!item) return;
      const overlay = document.getElementById('pmodalOverlay');
      const photos = document.getElementById('pmodalPhotos');
      const meta = document.getElementById('pmodalMeta');
      const city = document.getElementById('pmodalCity');
      const note = document.getElementById('pmodalNote');
      const fields = document.getElementById('pmodalFields');

      if (photos) {
        photos.innerHTML = item.photo
          ? `<div class="pmodal-photo" style="grid-column: 1 / -1"><img src="${escapeHTML(item.photo)}" alt="${escapeHTML(item.name)}"></div>`
          : `<div class="pmodal-photo" style="grid-column: 1 / -1; font-size: 4rem;">🌍</div>`;
      }
      if (meta) meta.textContent = `Planned trip · ${item.when}${item.where ? ' · ' + item.where : ''}`;
      if (city) city.textContent = item.name;
      if (note) note.textContent = item.why;
      if (fields) {
        const entries: Array<{ icon: string; label: string; value: string }> = [];
        if (item.where) entries.push({ icon: '📍', label: 'Where', value: item.where });
        if (item.when) entries.push({ icon: '📅', label: 'Target', value: item.when });
        if (item.details) entries.push({ icon: '🗺', label: 'Plan', value: item.details });
        fields.innerHTML = entries.map(e => `
          <div class="pmodal-field">
            <div class="pmodal-field-label">${e.icon} ${e.label}</div>
            <div class="pmodal-field-value">${escapeHTML(e.value)}</div>
          </div>
        `).join('');
      }
      overlay?.classList.add('open');
    }

    async function syncFinance() {
      const rows = await fetchSheet(FINANCE_SHEET_CSV);
      if (!rows.length) return;
      const portfolioRows = rows.filter(r => r.type === 'portfolio');
      const pickRows = rows.filter(r => r.type === 'pick');

      const portfolioLabel: Record<string, { cls: string; label: string }> = {
        core: { cls: 'long', label: 'Core' },
        long: { cls: 'long', label: 'Long' },
        watch: { cls: 'watch', label: 'Dry' },
        avoid: { cls: 'avoid', label: 'Avoid' }
      };
      const pickLabel: Record<string, { cls: string; label: string }> = {
        long: { cls: 'long', label: 'Long' },
        watch: { cls: 'watch', label: 'Watch' },
        avoid: { cls: 'avoid', label: 'Avoid' }
      };

      const tbl = document.querySelector('#portfolio .positions-table');
      if (tbl && portfolioRows.length) {
        const head = `<div class="position-row position-head"><span>Ticker</span><span>Alloc</span><span>Entry</span><span>Stance</span><span class="position-thesis">Thesis</span></div>`;
        const body = portfolioRows.map(r => {
          const m = portfolioLabel[r.conviction] || portfolioLabel.long;
          return `
            <div class="position-row">
              <span class="position-ticker">${escapeHTML(r.ticker || '')}</span>
              <span class="position-alloc">${escapeHTML(r.alloc || '')}</span>
              <span class="position-entry">${escapeHTML(r.entry || '')}</span>
              <span class="pick-conviction ${m.cls}">${m.label}</span>
              <span class="position-thesis">${escapeHTML(r.thesis || '')}</span>
            </div>
          `;
        }).join('');
        tbl.innerHTML = head + body;
      }

      const picksGrid = document.querySelector('#picks .picks-grid');
      if (picksGrid && pickRows.length) {
        picksGrid.innerHTML = pickRows.map(r => {
          const m = pickLabel[r.conviction] || pickLabel.long;
          const photo = normalizePhotoUrl(r.photo || '');
          const photoHtml = photo
            ? `<img src="${escapeHTML(photo)}" alt="${escapeHTML(r.ticker || '')}" loading="lazy">`
            : `<span class="pick-photo-fallback">${escapeHTML((r.ticker || '?').slice(0, 4))}</span>`;
          return `
            <div class="pick-card">
              <div class="pick-photo">${photoHtml}</div>
              <div class="pick-head">
                <span class="pick-ticker">${escapeHTML(r.ticker || '')}</span>
                <span class="pick-conviction ${m.cls}">${m.label}</span>
              </div>
              <h4>${escapeHTML(r.headline || '')}</h4>
              <p>${escapeHTML(r.thesis || '')}</p>
            </div>
          `;
        }).join('');
      }
    }

    // ─── Photos ────────────────────────────────────────────
    interface Photo { placeId: string; url: string; caption: string; date: string; }
    let photosData: Photo[] = [];

    // Convert a Google Drive sharing URL into one that can be used in <img src=...>.
    // Direct image URLs (https + image extension) are passed through unchanged.
    function normalizePhotoUrl(url: string): string {
      if (!url) return '';
      const trimmed = url.trim();
      const driveFile = trimmed.match(/drive\.google\.com\/file\/d\/([^\/\?]+)/);
      if (driveFile) return `https://lh3.googleusercontent.com/d/${driveFile[1]}`;
      const driveUc = trimmed.match(/drive\.google\.com\/uc\?(?:export=view&)?id=([^&]+)/);
      if (driveUc) return `https://lh3.googleusercontent.com/d/${driveUc[1]}`;
      const openId = trimmed.match(/drive\.google\.com\/open\?id=([^&]+)/);
      if (openId) return `https://lh3.googleusercontent.com/d/${openId[1]}`;
      return trimmed;
    }

    async function syncPhotos() {
      const rows = await fetchSheet(PHOTOS_SHEET_CSV);
      photosData = rows.map(r => ({
        placeId: (r.place_id || '').trim(),
        url: normalizePhotoUrl(r.url || ''),
        caption: r.caption || '',
        date: r.date || ''
      })).filter(p => p.url);
      renderAlbum();
    }

    function renderAlbum() {
      const grid = document.querySelector('#album .album-grid');
      const foot = document.querySelector('#album .album-foot') as HTMLElement | null;
      if (!grid) return;
      if (photosData.length === 0) return;
      grid.innerHTML = photosData.map((p, i) => {
        const place = placesData.find(pl => pl.id === p.placeId);
        const span = (i % 5 === 0) ? 2 : 1;
        const cityShort = place ? escapeHTML(place.city.split(',')[0]) : '';
        return `
          <div class="album-tile photo" style="--span: ${span}" data-place-id="${escapeHTML(p.placeId)}">
            <img src="${escapeHTML(p.url)}" alt="${escapeHTML(p.caption || cityShort)}" loading="lazy">
            ${(cityShort || p.caption || p.date) ? `
              <div class="album-tile-caption">
                ${cityShort ? `<span class="album-tile-place">${cityShort}</span>` : ''}
                ${p.date ? `<span class="album-tile-date">${escapeHTML(p.date)}</span>` : ''}
              </div>` : ''}
          </div>
        `;
      }).join('');
      grid.querySelectorAll<HTMLElement>('.album-tile.photo').forEach(el => {
        el.style.cursor = 'pointer';
        el.addEventListener('click', () => {
          const id = el.dataset.placeId;
          if (id) openPlaceModal(id);
        });
      });
      if (foot) foot.style.display = 'none';
    }

    async function syncRoutines() {
      const rows = await fetchSheet(ROUTINES_SHEET_CSV);
      if (!rows.length) return;
      const grid = document.querySelector('#routines .routines-grid');
      if (!grid) return;
      grid.innerHTML = rows.map(r => `
        <div class="routine-card">
          <div class="routine-duration">${escapeHTML(r.duration || '')}</div>
          <h4>${escapeHTML(r.name || '')}</h4>
          <div class="routine-target">${escapeHTML([r.target, r.level].filter(Boolean).join(' · '))}</div>
          <p>${escapeHTML(r.note || '')}</p>
          ${r.link ? `<a href="${escapeHTML(r.link)}" target="_blank" class="rehab-link">Watch →</a>` : ''}
        </div>
      `).join('');
    }

    async function syncNotebook() {
      const rows = await fetchSheet(NOTEBOOK_SHEET_CSV);
      if (!rows.length) return;
      const list = document.querySelector('#notebook .notebook-list');
      if (!list) return;
      const tagClass: Record<string, string> = {
        personal: 'personal',
        'evidence-based': 'evidence',
        evidence: 'evidence',
        woo: 'woo'
      };
      list.innerHTML = rows.map(r => {
        const cls = tagClass[(r.tag || '').toLowerCase()] || 'personal';
        return `
          <article class="note-card">
            <div class="note-meta">
              <span class="note-tag ${cls}">${escapeHTML(r.tag || 'personal')}</span>
              <span class="note-date">${escapeHTML(r.date || '')}</span>
            </div>
            <h3>${r.link ? `<a href="${escapeHTML(r.link)}" target="_blank" style="color:inherit;text-decoration:none">${escapeHTML(r.title || '')}</a>` : escapeHTML(r.title || '')}</h3>
            <p>${escapeHTML(r.dek || '')}</p>
          </article>
        `;
      }).join('');
    }

    async function loadPlacesFromSheet(): Promise<boolean> {
      if (!PLACES_SHEET_CSV) return false;
      try {
        const res = await fetch(PLACES_SHEET_CSV, { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const text = await res.text();
        const rows = parseCSV(text);
        const fresh = rows.map(rowToPlace).filter((p): p is Place => p !== null);
        if (fresh.length > 0) {
          placesData.length = 0;
          fresh.forEach(p => placesData.push(p));
          return true;
        }
        return false;
      } catch (e) {
        console.warn('[places] Sheet load failed, using hardcoded fallback:', e);
        return false;
      }
    }

    const placesData: Place[] = [
      // 2023 — Big Bend Depart loop
      { id: 'big-bend', city: 'Big Bend NP, TX', coords: [29.1275, -103.2425], date: '2023', country: 'USA',
        note: 'Big Bend Depart. The trip that started everything. Stars you can read by.' },
      { id: 'guadalupe', city: 'Guadalupe Mountains NP, TX', coords: [31.923, -104.8669], date: '2023', country: 'USA',
        note: 'Highest point in Texas. Empty trails, gypsum dust.' },
      { id: 'white-sands', city: 'White Sands, NM', coords: [32.7872, -106.3257], date: '2023', country: 'USA',
        note: 'Gypsum dunes at golden hour. Sledding for adults.' },
      { id: 'saguaro', city: 'Saguaro NP, AZ', coords: [32.2967, -111.1664], date: '2023', country: 'USA',
