    .theme-option .theme-name {
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1.2;
    }

    .settings-note {
      font-size: 0.75rem;
      color: var(--text-dim);
      line-height: 1.4;
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 3rem;
