---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Austin Nafe - Builder & Creator</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Fraunces:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Lora:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Serif:wght@400;700&family=IBM+Plex+Mono:wght@400;700&family=JetBrains+Mono:wght@400;700&family=Caveat:wght@400;700&family=Space+Grotesk:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root,
    [data-theme="midnight"] {
      --forest: #2d5016;
      --ocean: #0077be;
      --coral: #ff6b6b;
      --bg: #0a0e27;
      --bg-light: #1a1f3a;
      --bg-card: #252b4a;
      --text: #e8eef7;
      --text-dim: #8b95b0;
      --border: #2d3557;
      --nav-bg: rgba(10, 14, 39, 0.8);
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-heading: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, monospace;
    }

    [data-theme="cream"] {
      --forest: #c4621a;
      --ocean: #e8651c;
      --coral: #d94a0f;
      --bg: #f5efe0;
      --bg-light: #faf6ec;
      --bg-card: #ffffff;
      --text: #2a1f10;
      --text-dim: #6b5d4a;
      --border: #e3d6b8;
      --nav-bg: rgba(245, 239, 224, 0.85);
      --font-heading: 'Caveat', cursive;
    }

    [data-theme="healthcare"] {
      --forest: #14b8a6;
      --ocean: #0ea5e9;
      --coral: #f87171;
      --bg: #f0f7fa;
      --bg-light: #ffffff;
      --bg-card: #ffffff;
      --text: #0f2740;
      --text-dim: #5a7080;
      --border: #d6e3ea;
      --nav-bg: rgba(240, 247, 250, 0.85);
      --font-heading: 'IBM Plex Serif', Georgia, serif;
    }

    [data-theme="adventure"] {
      --forest: #6b8e4e;
      --ocean: #d4a574;
      --coral: #e85d4a;
      --bg: #1a2419;
      --bg-light: #2a3a28;
      --bg-card: #354733;
      --text: #f5f1e8;
      --text-dim: #a8b09e;
      --border: #4a5d47;
      --nav-bg: rgba(26, 36, 25, 0.85);
      --font-heading: 'Lora', Georgia, serif;
    }

    [data-theme="creative"] {
      --forest: #ec4899;
      --ocean: #8b5cf6;
      --coral: #fbbf24;
      --bg: #1a0b2e;
      --bg-light: #2d1457;
      --bg-card: #3d1f6b;
      --text: #faf3ff;
      --text-dim: #b39ddb;
      --border: #4a2b7a;
      --nav-bg: rgba(26, 11, 46, 0.85);
      --font-heading: 'Space Grotesk', 'Inter', sans-serif;
    }

    [data-theme="agents"] {
      --forest: #00d9b2;
      --ocean: #3b82f6;
      --coral: #c084fc;
      --bg: #050817;
      --bg-light: #0e1530;
      --bg-card: #161e3d;
      --text: #e2f3ff;
      --text-dim: #6b8aae;
      --border: #1f2d50;
      --nav-bg: rgba(5, 8, 23, 0.85);
      --font-heading: 'JetBrains Mono', ui-monospace, monospace;
      --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    }

    [data-theme="cyber"] {
      --forest: #00ff41;
      --ocean: #ff003c;
      --coral: #ffb700;
      --bg: #0a0f0a;
      --bg-light: #131a13;
      --bg-card: #1a241a;
      --text: #d8ffd8;
      --text-dim: #6b8c6b;
      --border: #2a3a2a;
      --nav-bg: rgba(10, 15, 10, 0.85);
      --font-body: 'IBM Plex Mono', ui-monospace, monospace;
      --font-heading: 'IBM Plex Mono', ui-monospace, monospace;
    }

    [data-theme="finance"] {
      --forest: #d4af37;
      --ocean: #2d8659;
      --coral: #b08d57;
      --bg: #0c1419;
      --bg-light: #16222b;
      --bg-card: #1e2d39;
      --text: #f0e9d2;
      --text-dim: #8a9aa8;
      --border: #2a3d4d;
      --nav-bg: rgba(12, 20, 25, 0.85);
    }

    [data-theme="founder"] {
      --forest: #dc2626;
      --ocean: #0a0a0a;
      --coral: #f59e0b;
      --bg: #ffffff;
      --bg-light: #fafafa;
      --bg-card: #ffffff;
      --text: #0a0a0a;
      --text-dim: #525252;
      --border: #e5e5e5;
      --nav-bg: rgba(255, 255, 255, 0.9);
      --font-heading: 'Fraunces', Georgia, serif;
    }

    [data-theme="wellness"] {
      --forest: #6b9ba0;
      --ocean: #b56b6b;
      --coral: #d4a942;
      --bg: #f5ede3;
      --bg-light: #faf5ed;
      --bg-card: #ffffff;
      --text: #3a2e1f;
      --text-dim: #7a6a55;
      --border: #e0d3bf;
      --nav-bg: rgba(245, 237, 227, 0.88);
      --font-heading: 'Fraunces', Georgia, serif;
    }

    [data-theme="garden"] {
      --forest: #6b8e23;
      --ocean: #c97b4c;
      --coral: #d4a017;
      --bg: #faf5e6;
      --bg-light: #f1ead4;
      --bg-card: #ffffff;
      --text: #2d3220;
      --text-dim: #6b7355;
      --border: #d4cea8;
      --nav-bg: rgba(250, 245, 230, 0.88);
      --font-heading: 'Fraunces', Georgia, serif;
    }

    body {
      font-family: var(--font-body);
      line-height: 1.6;
      color: var(--text);
      background: var(--bg);
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .section-header h2, .hero h1 {
      font-family: var(--font-heading);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    nav {
      padding: 1.5rem 0;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: var(--nav-bg);
      backdrop-filter: blur(20px);
      z-index: 100;
      border-bottom: 1px solid var(--border);
    }

    nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--text);
      text-decoration: none;
    }

    nav ul {
      display: flex;
      gap: 2.5rem;
      list-style: none;
      align-items: center;
    }

    nav a {
      color: var(--text-dim);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s;
      position: relative;
    }

    nav a::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--forest), var(--ocean), var(--coral));
      transition: width 0.3s;
    }

    nav a:hover {
      color: var(--text);
    }

    nav a:hover::after {
      width: 100%;
    }

    .hero {
      padding: 12rem 0 8rem;
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      display: flex;
      align-items: center;
    }

    .floating-shape {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.3;
      animation: float 20s infinite ease-in-out;
    }

    .shape-1 {
      width: 400px;
      height: 400px;
      background: var(--forest);
      top: 10%;
      right: 10%;
    }

    .shape-2 {
      width: 300px;
      height: 300px;
      background: var(--ocean);
      bottom: 20%;
      left: 5%;
      animation-delay: 5s;
    }

    .shape-3 {
      width: 350px;
      height: 350px;
      background: var(--coral);
      top: 50%;
      left: 50%;
      animation-delay: 10s;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(30px, -30px) rotate(90deg); }
      50% { transform: translate(-20px, 20px) rotate(180deg); }
      75% { transform: translate(40px, 10px) rotate(270deg); }
    }

    .hero .container {
      position: relative;
      z-index: 1;
    }

    .hero-content {
      display: flex;
      align-items: center;
      gap: 4rem;
    }

    .hero-text {
      flex: 1;
    }

    .hero-image {
      width: 300px;
      height: 300px;
      border-radius: 50%;
      padding: 4px;
      background: linear-gradient(135deg, var(--forest), var(--ocean), var(--coral));
      animation: float 6s infinite ease-in-out;
      box-shadow: 0 20px 60px rgba(0, 119, 190, 0.4);
      flex-shrink: 0;
    }

    .hero-image img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      display: block;
    }

    .open-to-work {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      background: rgba(45, 80, 22, 0.15);
      border: 1px solid var(--forest);
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #6fcf97;
      margin-bottom: 1.25rem;
      animation: slideUp 0.8s ease-out;
    }

    .open-to-work::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #6fcf97;
      box-shadow: 0 0 10px #6fcf97;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .now-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .now-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
      transition: all 0.3s;
    }

    .now-card:hover {
      border-color: var(--ocean);
      transform: translateY(-4px);
    }

    .now-card .now-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--coral);
      margin-bottom: 0.5rem;
    }

    .now-card h4 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .now-card p {
      font-size: 0.95rem;
      color: var(--text-dim);
      line-height: 1.6;
    }

    /* ─── Now playing / reading / watching ────────────── */
    .np-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .np-card {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 1.25rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      text-decoration: none;
      color: inherit;
      transition: all 0.3s;
    }

    .np-card:hover {
      transform: translateY(-4px);
      border-color: var(--coral);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    }

    .np-icon {
      width: 72px;
      height: 72px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--bg-card), var(--bg));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      flex-shrink: 0;
    }

    .np-kind {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--coral);
      font-weight: 800;
      margin-bottom: 0.35rem;
    }

    .np-title {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.1;
      color: var(--text);
      margin-bottom: 0.2rem;
    }

    .np-by {
      font-size: 0.85rem;
      color: var(--text-dim);
      margin-bottom: 0.6rem;
    }

    .np-by em {
      font-style: italic;
    }

    .np-note {
      color: var(--text-dim);
      font-size: 0.9rem;
      line-height: 1.55;
      margin-bottom: 0.75rem;
    }

    .np-link {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--ocean);
    }

    /* ─── Agent Zoo ─────────────────────────────────────── */
    .zoo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .agent-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      transition: all 0.3s;
    }

    .agent-card:hover {
      transform: translateY(-4px);
      border-color: var(--ocean);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    }

    .agent-head {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 1rem;
      align-items: center;
    }

    .agent-avatar {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--bg-card), var(--bg));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      flex-shrink: 0;
    }

    .agent-name {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.1;
    }

    .agent-role {
      font-size: 0.82rem;
      color: var(--text-dim);
      margin-top: 0.2rem;
      line-height: 1.4;
    }

    .agent-status {
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 0.3rem 0.6rem;
      border-radius: 8px;
      align-self: start;
      white-space: nowrap;
      border: 1px solid;
    }

    .agent-status.deployed { background: rgba(74, 222, 128, 0.15); color: #4ade80; border-color: #4ade80; }
    .agent-status.live { background: rgba(14, 165, 233, 0.18); color: #38bdf8; border-color: #38bdf8; }
    .agent-status.building { background: rgba(251, 191, 36, 0.18); color: #fbbf24; border-color: #fbbf24; }
    .agent-status.stealth { background: rgba(212, 175, 55, 0.18); color: #d4af37; border-color: #d4af37; }
    .agent-status.archived { background: rgba(120, 113, 108, 0.18); color: #a8a29e; border-color: #a8a29e; }

    .agent-quote {
      font-family: var(--font-heading);
      font-style: italic;
      color: var(--text);
      font-size: 0.98rem;
      line-height: 1.6;
      padding: 0.75rem 1rem;
      border-left: 3px solid var(--coral);
      background: rgba(255, 107, 107, 0.05);
      border-radius: 4px;
    }

    .agent-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .agent-caps {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      font-size: 0.7rem;
      color: var(--text-dim);
      padding-top: 0.5rem;
      border-top: 1px dashed var(--border);
    }

    .agent-caps span {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 0.25rem 0.55rem;
      border-radius: 8px;
      font-family: var(--font-mono);
    }

    .agent-try {
      align-self: flex-start;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--coral);
      text-decoration: none;
      padding: 0.5rem 0.9rem;
      border: 1px solid var(--coral);
      border-radius: 8px;
      transition: all 0.2s;
    }

    .agent-try:hover {
      background: var(--coral);
      color: var(--bg);
      transform: translateX(3px);
    }

    /* ─── Stack ─────────────────────────────────────────── */
    .stack-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .stack-cat {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem 1.75rem;
    }

    .stack-cat h4 {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--coral);
      margin-bottom: 1rem;
      font-weight: 800;
    }

    .stack-cat ul {
      list-style: none;
      padding: 0;
    }

    .stack-cat li {
      padding: 0.45rem 0;
      color: var(--text);
      font-size: 0.95rem;
      border-bottom: 1px dashed var(--border);
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .stack-cat li:last-child {
      border-bottom: none;
    }

    .stack-cat li em {
      font-style: italic;
      font-size: 0.7rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
    }

    /* ─── FAQ ───────────────────────────────────────────── */
    .faq-list {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .faq-item {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 1rem 1.5rem;
      transition: border-color 0.2s;
    }

    .faq-item[open] {
      border-color: var(--ocean);
    }

    .faq-item summary {
      font-weight: 700;
      font-size: 1.05rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: var(--text);
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      content: "+";
      font-family: var(--font-mono);
      font-size: 1.3rem;
      color: var(--text-dim);
      transition: transform 0.2s;
    }

    .faq-item[open] summary::after {
      content: "−";
    }

    .faq-item p {
      margin-top: 0.75rem;
      color: var(--text-dim);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    /* ─── Healthcare: stat block + manifesto pull-quote ── */
    .hc-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      max-width: 1000px;
      margin: 0 auto 3rem;
      background: var(--bg-light);
      border-radius: 16px;
      padding: 1.75rem;
      border: 2px solid var(--border);
    }

    .hc-stat {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      text-align: center;
      padding: 0 1rem;
    }

    .hc-stat-num {
      font-family: var(--font-heading);
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--forest);
      line-height: 1;
    }

    .hc-stat-label {
      font-size: 0.75rem;
      color: var(--text-dim);
      line-height: 1.4;
    }

    .hc-quote {
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
      padding: 0 2rem;
    }

    .hc-quote p {
      font-family: var(--font-heading);
      font-size: clamp(1.4rem, 2.5vw, 1.75rem);
      line-height: 1.45;
      font-style: italic;
      color: var(--text);
    }

    /* ECG-style divider above the why-healthcare section (Healthcare only) */
    [data-theme="healthcare"] #why-healthcare {
      position: relative;
    }

    [data-theme="healthcare"] #why-healthcare::before {
      content: "";
      position: absolute;
      top: 2.5rem;
      left: 0;
      right: 0;
      height: 30px;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 30' preserveAspectRatio='none'><path d='M0 15 L40 15 L48 5 L56 25 L64 15 L120 15 L128 8 L132 22 L136 15 L200 15' stroke='%2314b8a6' stroke-width='1.5' fill='none' opacity='0.5'/></svg>");
      background-repeat: repeat-x;
      background-size: 200px 30px;
    }

    /* ─── Album / Photo wall (Adventure only) ───────────── */
    .album-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 160px;
      gap: 6px;
    }

    .album-tile {
      grid-column: span var(--span, 1);
      background: linear-gradient(135deg, var(--bg-light), var(--bg-card));
      border: 1px solid var(--border);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dim);
      font-size: 1.5rem;
      transition: all 0.3s;
      cursor: pointer;
    }

    .album-tile:hover {
      transform: scale(1.02);
      border-color: var(--coral);
    }

    .album-tile.photo {
      padding: 0;
      overflow: hidden;
      position: relative;
    }

    .album-tile.photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .album-tile-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 0.55rem 0.85rem;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
      color: #fff;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      font-size: 0.78rem;
      letter-spacing: 0.02em;
    }

    .album-tile-place {
      font-family: var(--font-heading);
      font-weight: 700;
    }

    .album-tile-date {
      opacity: 0.8;
      font-family: var(--font-mono);
      font-size: 0.7rem;
    }

    .album-foot {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-dim);
      font-style: italic;
    }

    .album-foot code {
      font-family: var(--font-mono);
      background: var(--bg-card);
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.85em;
    }

    @media (max-width: 720px) {
      .album-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ─── Cream polaroid hero ──────────────────────────── */
    [data-theme="cream"] .hero-image {
      border-radius: 6px;
      padding: 12px 12px 56px;
      background: #ffffff;
      transform: rotate(-3deg);
      box-shadow: 0 10px 30px rgba(45, 30, 10, 0.15), 0 2px 6px rgba(45, 30, 10, 0.1);
      animation: none;
      position: relative;
    }

    [data-theme="cream"] .hero-image::after {
      content: "Austin · 2024";
      position: absolute;
      bottom: 14px;
      left: 0;
      right: 0;
      text-align: center;
      font-family: 'Caveat', cursive;
      font-size: 1.4rem;
      color: #2a1f10;
      opacity: 0.7;
    }

    [data-theme="cream"] .hero-image img {
      border-radius: 0;
    }

    /* Hand-drawn underline on links in cream theme */
    [data-theme="cream"] nav a:hover::after {
      background: var(--coral);
      height: 3px;
      border-radius: 2px;
    }

    /* ─── The Numbers (Founder only) ─────────────────────── */
    .numbers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      max-width: 1000px;
      margin: 0 auto;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
    }

    .number-tile {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      text-align: center;
      padding: 0.75rem;
      border-right: 1px solid var(--border);
    }

    .number-tile:last-child { border-right: none; }

    .number-value {
      font-family: var(--font-heading);
      font-size: 2.75rem;
      font-weight: 700;
      font-style: italic;
      line-height: 1;
      color: var(--text);
    }

    .number-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      color: var(--text-dim);
      font-weight: 700;
    }

    /* ─── Decisions Log (Founder only) ────────────────────── */
    .decisions-list {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .decision {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem 1.75rem;
      transition: all 0.3s;
    }

    .decision:hover { border-color: var(--coral); }

    .decision-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .decision-date {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 0.85rem;
      color: var(--text-dim);
      letter-spacing: 0.02em;
    }

    .decision-outcome {
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      border: 1px solid;
    }

    .decision-outcome.worked { background: rgba(74, 222, 128, 0.15); color: #4ade80; border-color: #4ade80; }
    .decision-outcome.open { background: rgba(212, 175, 55, 0.15); color: #d4af37; border-color: #d4af37; }
    .decision-outcome.reversed { background: rgba(248, 113, 113, 0.15); color: #f87171; border-color: #f87171; }

    .decision h4 {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 0.6rem;
      color: var(--text);
    }

    .decision p {
      color: var(--text);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    /* ─── Founder magazine treatment ─────────────────────── */
    [data-theme="founder"] .hero {
      padding-top: 9rem;
    }

    [data-theme="founder"] .hero::before {
      content: "ISSUE №01 · BUILDING BOUNDLESSLY · MAY 2026";
      position: absolute;
      top: 5.5rem;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-heading);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--text-dim);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 0.4rem 1.5rem;
      z-index: 2;
      white-space: nowrap;
    }

    [data-theme="founder"] .hero h1 {
      font-size: clamp(3.5rem, 9vw, 7rem);
      letter-spacing: -0.04em;
      line-height: 0.92;
      font-weight: 900;
      font-style: italic;
      background: none;
      -webkit-background-clip: initial;
      -webkit-text-fill-color: var(--text);
      background-clip: initial;
      color: var(--text);
    }

    [data-theme="founder"] .hero .subtitle {
      font-style: italic;
      font-family: var(--font-heading);
      font-weight: 400;
      letter-spacing: -0.01em;
      font-size: 1.5rem;
      color: var(--text-dim);
    }

    [data-theme="founder"] .hero .bio {
      font-size: 1.15rem;
      line-height: 1.7;
      color: var(--text);
    }

    [data-theme="founder"] .hero .bio::first-letter {
      font-family: var(--font-heading);
      font-size: 4rem;
      font-weight: 900;
      font-style: italic;
      float: left;
      line-height: 0.9;
      margin: 0.15rem 0.6rem 0 0;
      color: var(--forest);
    }

    [data-theme="founder"] .section-header h2 {
      font-style: italic;
      font-weight: 900;
      letter-spacing: -0.03em;
      font-size: clamp(2.5rem, 5vw, 4rem);
    }

    [data-theme="founder"] .section-header h2::after {
      display: none;
    }

    [data-theme="founder"] .section-header p {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 1.1rem;
    }

    /* Hide the floating shapes on Founder for a magazine-clean feel */
    [data-theme="founder"] .floating-shape {
      display: none;
    }

    /* Press strip */
    .press-kicker {
      text-align: center;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.4em;
      color: var(--text-dim);
      font-weight: 800;
      margin-bottom: 2rem;
      font-family: var(--font-body);
    }

    .press-logos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.75rem 3.5rem;
      align-items: baseline;
      max-width: 900px;
      margin: 0 auto;
    }

    .press-logos span {
      font-family: var(--font-heading);
      font-style: italic;
      font-weight: 900;
      font-size: 1.6rem;
      color: var(--text-dim);
      letter-spacing: -0.01em;
      opacity: 0.5;
      transition: opacity 0.25s, color 0.25s;
      cursor: default;
    }

    .press-logos span:hover {
      opacity: 1;
      color: var(--text);
    }

    .press-foot {
      text-align: center;
      margin-top: 2rem;
      font-size: 0.8rem;
      color: var(--text-dim);
      font-style: italic;
      font-family: var(--font-heading);
    }

    /* Manifesto */
    .manifesto-block {
      max-width: 820px;
      margin: 0 auto;
      text-align: center;
      padding: 5rem 2rem 4rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      position: relative;
    }

    .manifesto-mark {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 8rem;
      line-height: 0.4;
      color: var(--coral);
      position: absolute;
      top: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      opacity: 0.85;
    }

    .manifesto-quote {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: clamp(1.7rem, 3.8vw, 2.6rem);
      font-weight: 400;
      line-height: 1.35;
      color: var(--text);
      margin-top: 2rem;
    }

    .manifesto-byline {
      margin-top: 2rem;
      font-style: italic;
      color: var(--text-dim);
      font-family: var(--font-heading);
      font-size: 0.95rem;
      letter-spacing: 0.02em;
    }

    /* ─── Boundless Horizons (Founder only) ─────────────── */
    .business-card.boundless {
      background: linear-gradient(135deg, var(--bg-light), var(--bg-card));
      position: relative;
    }

    .business-card.boundless::before {
      transform: scaleX(1);
    }

    .business-card.boundless h3 {
      font-family: var(--font-heading);
      font-size: 2rem;
      letter-spacing: -0.02em;
    }

    /* ─── My Picks (Finance only) ───────────────────────── */
    .picks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .pick-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      transition: all 0.3s;
      overflow: hidden;
    }

    .pick-photo {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      overflow: hidden;
      background: linear-gradient(135deg, var(--bg-card), var(--bg));
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
      border: 1px solid var(--border);
    }

    .pick-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .pick-photo-fallback {
      font-family: var(--font-mono);
      font-weight: 800;
      font-size: 0.9rem;
      color: var(--text-dim);
      letter-spacing: 0.05em;
    }

    .pick-card:hover {
      transform: translateY(-4px);
      border-color: var(--forest);
    }

    .pick-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .pick-ticker {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 0.05em;
      color: var(--text);
    }

    .pick-conviction {
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
    }

    .pick-conviction.long {
      background: rgba(45, 134, 89, 0.15);
      color: #4ade80;
      border: 1px solid #4ade80;
    }

    .pick-conviction.watch {
      background: rgba(212, 175, 55, 0.15);
      color: #d4af37;
      border: 1px solid #d4af37;
    }

    .pick-conviction.avoid {
      background: rgba(220, 38, 38, 0.15);
      color: #f87171;
      border: 1px solid #f87171;
    }

    .pick-card h4 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .pick-card p {
      font-size: 0.9rem;
      color: var(--text-dim);
      line-height: 1.6;
    }

    /* ─── Quarterly Letter (Finance only) ───────────────── */
    .ql {
      max-width: 720px;
      margin: 0 auto;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 3rem 3rem 2.5rem;
      position: relative;
    }

    .ql-meta {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      color: var(--text-dim);
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .ql-title {
      font-family: var(--font-heading);
      font-size: 1.65rem;
      line-height: 1.25;
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: var(--text);
    }

    .ql-lede {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 1.1rem;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .ql p {
      color: var(--text);
      line-height: 1.75;
      font-size: 1rem;
      margin-bottom: 1.1rem;
    }

    .ql strong {
      color: var(--forest);
      font-weight: 800;
    }

    .ql em {
      font-style: italic;
      color: var(--coral);
    }

    .ql-sign {
      margin-top: 2rem !important;
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 1.1rem;
    }

    .ql-sign-meta {
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    .ql-disclaimer {
      margin-top: 2rem !important;
      font-size: 0.7rem !important;
      color: var(--text-dim);
      font-style: italic;
      border-top: 1px solid var(--border);
      padding-top: 1rem;
    }

    /* ─── Charts I Made (Finance only) ─────────────────── */
    .charts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .chart-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .chart-card-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.25rem;
    }

    .chart-card-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 800;
      color: var(--text-dim);
    }

    .chart-card-stat {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
    }

    .chart-card-stat.positive { color: #4ade80; }
    .chart-card-stat.negative { color: #f87171; }

    .chart-svg {
      width: 100%;
      height: auto;
      display: block;
    }

    .chart-svg.donut {
      max-width: 200px;
      margin: 0 auto;
    }

    .chart-card-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      margin-top: 1rem;
      font-size: 0.75rem;
      color: var(--text-dim);
    }

    .chart-card-legend .ledge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .chart-card-legend .ledge i {
      width: 12px;
      height: 12px;
      border-radius: 3px;
      display: inline-block;
    }

    .chart-card-legend.allocs {
      font-family: var(--font-mono);
    }

    /* ─── Wellness: Practice ────────────────────────────── */
    .practice-card {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 20px;
      padding: 2rem;
    }

    .practice-photo {
      width: 220px;
      height: 220px;
      border-radius: 16px;
      background: linear-gradient(135deg, var(--bg-card), var(--bg));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
    }

    .practice-cred {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--coral);
      font-weight: 800;
      margin-bottom: 0.5rem;
    }

    .practice-body h3 {
      font-family: var(--font-heading);
      font-size: 1.6rem;
      margin-bottom: 0.75rem;
      color: var(--text);
    }

    .practice-body p {
      color: var(--text-dim);
      line-height: 1.65;
      margin-bottom: 0.85rem;
    }

    .practice-where {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      margin-top: 1.25rem;
      font-size: 0.85rem;
      color: var(--text-dim);
      align-items: center;
    }

    .practice-book {
      margin-left: auto;
      color: var(--ocean);
      text-decoration: none;
      font-weight: 700;
    }

    @media (max-width: 720px) {
      .practice-card { grid-template-columns: 1fr; }
      .practice-photo { width: 100%; height: 160px; }
    }

    /* ─── Wellness: Routines ────────────────────────────── */
    .routines-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
    }

    .routine-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem;
      position: relative;
      transition: all 0.3s;
    }

    .routine-card:hover {
      transform: translateY(-3px);
      border-color: var(--ocean);
    }

    .routine-duration {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      padding: 0.3rem 0.7rem;
      border-radius: 8px;
      background: rgba(107, 155, 160, 0.15);
      color: var(--forest);
      border: 1px solid var(--forest);
      margin-bottom: 0.85rem;
    }

    .routine-card h4 {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      line-height: 1.15;
      margin-bottom: 0.35rem;
      color: var(--text);
    }

    .routine-target {
      font-size: 0.8rem;
      color: var(--coral);
      font-style: italic;
      margin-bottom: 0.65rem;
    }

    .routine-card p {
      color: var(--text-dim);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    /* ─── Wellness: Notebook ────────────────────────────── */
    .notebook-list {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .note-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem 1.75rem;
      transition: border-color 0.2s;
      cursor: default;
    }

    .note-card:hover {
      border-color: var(--coral);
    }

    .note-meta {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 0.65rem;
    }

    .note-tag {
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      border: 1px solid;
    }

    .note-tag.personal { background: rgba(181, 107, 107, 0.12); color: #b56b6b; border-color: #b56b6b; }
    .note-tag.evidence { background: rgba(107, 155, 160, 0.15); color: #6b9ba0; border-color: #6b9ba0; }
    .note-tag.woo { background: rgba(212, 169, 66, 0.15); color: #b88a1a; border-color: #b88a1a; }

    .note-date {
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    .note-card h3 {
      font-family: var(--font-heading);
      font-size: 1.3rem;
      margin-bottom: 0.45rem;
      color: var(--text);
    }

    .note-card p {
      color: var(--text-dim);
      line-height: 1.6;
    }

    .notebook-disclaimer {
      text-align: center;
      max-width: 600px;
      margin: 1.75rem auto 0;
      font-size: 0.8rem;
      color: var(--text-dim);
      font-style: italic;
    }

    /* ─── Wellness: Rehab Tech ──────────────────────────── */
    .rehab-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .rehab-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem 1.75rem;
      transition: all 0.3s;
    }

    .rehab-card:hover {
      transform: translateY(-3px);
      border-color: var(--forest);
    }

    .rehab-icon {
      font-size: 2rem;
      display: block;
      margin-bottom: 0.85rem;
    }

    .rehab-card h4 {
      font-family: var(--font-heading);
      font-size: 1.2rem;
      margin-bottom: 0.55rem;
      color: var(--text);
    }

    .rehab-card p {
      color: var(--text-dim);
      font-size: 0.92rem;
      line-height: 1.6;
      margin-bottom: 0.85rem;
    }

    .rehab-link {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--ocean);
      text-decoration: none;
    }

    /* ─── The Rig (Adventure only) ──────────────────────── */
    .rig-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .rig-hero {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      align-self: start;
      position: sticky;
      top: 8rem;
    }

    .rig-photo {
      aspect-ratio: 4 / 3;
      background: linear-gradient(135deg, var(--bg-card), var(--bg));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
    }

    .rig-name {
      font-family: var(--font-heading);
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text);
    }

    .rig-spec {
      font-size: 0.85rem;
      color: var(--text-dim);
      margin-bottom: 0.75rem;
      font-style: italic;
    }

    .rig-status {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      padding: 0.35rem 0.7rem;
      border-radius: 8px;
      border: 1px solid var(--coral);
      color: var(--coral);
      background: rgba(232, 93, 74, 0.12);
    }

    .rig-phases {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .rig-phase {
      display: grid;
      grid-template-columns: 36px 1fr;
      gap: 1rem;
      padding: 1.25rem 1.5rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 12px;
      transition: border-color 0.2s;
    }

    .rig-phase.done { border-color: rgba(74, 222, 128, 0.4); }
    .rig-phase.doing { border-color: var(--coral); }
    .rig-phase.todo { opacity: 0.78; }

    .phase-mark {
      font-family: var(--font-mono);
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1;
      align-self: center;
      text-align: center;
    }

    .rig-phase.done .phase-mark { color: #4ade80; }
    .rig-phase.doing .phase-mark { color: var(--coral); animation: termBlink 1.5s infinite; }
    .rig-phase.todo .phase-mark { color: var(--text-dim); }

    .rig-phase-body h4 {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      margin-bottom: 0.35rem;
      color: var(--text);
    }

    .rig-phase-body p {
      color: var(--text-dim);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    @media (max-width: 820px) {
      .rig-grid { grid-template-columns: 1fr; }
      .rig-hero { position: static; }
    }

    /* ─── National Parks (Adventure only) ─────────────────── */
    .parks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.85rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .park {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.85rem 1.1rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 12px;
      transition: all 0.25s;
    }

    .park:hover {
      transform: translateY(-2px);
      border-color: var(--forest);
    }

    .park-emoji {
      font-size: 1.4rem;
    }

    .park-name {
      flex: 1;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text);
    }

    .park-year {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--coral);
      font-weight: 700;
    }

    .parks-foot {
      text-align: center;
      margin-top: 1.5rem;
      color: var(--text-dim);
      font-size: 0.85rem;
      font-style: italic;
    }

    /* ─── Festivals (Adventure only) ────────────────────────── */
    .fests-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .fest {
      display: grid;
      grid-template-columns: 52px 1fr;
      gap: 1rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.4rem;
      transition: all 0.3s;
    }

    .fest:hover {
      transform: translateY(-3px);
      border-color: var(--coral);
    }

    .fest-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--bg-card);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .fest-photo {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      overflow: hidden;
      background: var(--bg-card);
    }

    .fest-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .fest-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.5rem;
    }

    .fest-tag {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-dim);
    }

    .fest-name {
      font-family: var(--font-heading);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text);
    }

    .fest-meta {
      font-size: 0.78rem;
      color: var(--text-dim);
      font-style: italic;
      margin-bottom: 0.5rem;
    }

    .fest-note {
      color: var(--text);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    /* ─── Bucket List (Adventure only) ──────────────────── */
    .bucket-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .bucket-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      padding: 0;
      position: relative;
      transition: all 0.3s;
      cursor: pointer;
      display: flex;
      flex-direction: column;
    }

    .bucket-card:hover {
      transform: translateY(-5px);
      border-color: var(--coral);
      box-shadow: 0 16px 36px rgba(232, 93, 74, 0.2);
    }

    .bucket-photo {
      aspect-ratio: 16 / 10;
      background: linear-gradient(135deg, var(--bg-card), var(--bg));
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .bucket-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .bucket-photo-emoji {
      font-size: 4rem;
      opacity: 0.45;
    }

    .bucket-num {
      position: absolute;
      top: 0.85rem;
      right: 1rem;
      font-family: var(--font-heading);
      font-style: italic;
      font-size: 2rem;
      font-weight: 700;
      color: #fff;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
      line-height: 1;
    }

    .bucket-body {
      padding: 1.25rem 1.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .bucket-card h4 {
      font-family: var(--font-heading);
      font-size: 1.35rem;
      margin: 0;
      color: var(--text);
      line-height: 1.15;
    }

    .bucket-where {
      font-style: italic;
      color: var(--text-dim);
      font-size: 0.85rem;
      margin-bottom: 0.85rem;
    }

    .bucket-why {
      color: var(--text);
      font-size: 0.95rem;
      line-height: 1.55;
      margin-bottom: 1rem;
    }

    .bucket-when {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--forest);
      padding: 0.3rem 0.7rem;
      border: 1px solid var(--forest);
      border-radius: 10px;
    }

    /* ─── What I Pack (Adventure only) ──────────────────── */
    .pack-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .pack-cat {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem 1.75rem;
    }

    .pack-cat h4 {
      font-family: var(--font-heading);
      font-size: 1.05rem;
      margin-bottom: 1rem;
      color: var(--coral);
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
    }

    .pack-cat ul {
      list-style: none;
      padding: 0;
    }

    .pack-cat li {
      padding: 0.35rem 0;
      color: var(--text);
      font-size: 0.92rem;
      border-bottom: 1px dashed var(--border);
    }

    .pack-cat li:last-child {
      border-bottom: none;
    }

    /* ─── Portfolio (Finance only) ──────────────────────── */
    .portfolio-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .stat-tile {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.5rem 1rem;
      border-right: 1px solid var(--border);
    }

    .stat-tile:last-child {
      border-right: none;
    }

    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      font-weight: 700;
    }

    .stat-value {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .stat-value.positive { color: #4ade80; }
    .stat-value.negative { color: #f87171; }

    .positions-table {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }

    .position-row {
      display: grid;
      grid-template-columns: 90px 80px 80px 90px 1fr;
      gap: 1rem;
      padding: 1rem 1.5rem;
      align-items: center;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
    }

    .position-row:last-child {
      border-bottom: none;
    }

    .position-row:not(.position-head):hover {
      background: var(--bg-card);
    }

    .position-head {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      font-weight: 800;
      background: var(--bg-card);
    }

    .position-ticker {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text);
    }

    .position-alloc, .position-entry {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      color: var(--text-dim);
    }

    .position-thesis {
      color: var(--text-dim);
      line-height: 1.5;
    }

    .portfolio-footnote {
      margin-top: 1.25rem;
      font-size: 0.75rem;
      color: var(--text-dim);
      font-style: italic;
      text-align: center;
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    @media (max-width: 720px) {
      .position-row {
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
      }
      .position-row.position-head { display: none; }
      .position-thesis { grid-column: 1 / -1; font-size: 0.85rem; }
      .stat-tile { border-right: none; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }
      .stat-tile:last-child { border-bottom: none; }
    }

    /* ─── Dispatches (Adventure only) ───────────────────── */
    .dispatches-list {
      display: grid;
      gap: 1.5rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .dispatch {
      background: var(--bg-light);
      border-left: 4px solid var(--forest);
      border-radius: 4px 16px 16px 4px;
      padding: 1.5rem 2rem;
      transition: all 0.3s;
    }

    .dispatch:hover {
      transform: translateX(6px);
      border-left-color: var(--coral);
    }

    .dispatch-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.8rem;
      color: var(--text-dim);
      margin-bottom: 0.5rem;
      font-family: 'Lora', Georgia, serif;
      font-style: italic;
    }

    .dispatch-date {
      font-weight: 700;
      color: var(--coral);
    }

    .dispatch h4 {
      font-family: 'Lora', Georgia, serif;
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .dispatch p {
      color: var(--text-dim);
      line-height: 1.7;
    }

    /* ─── Studio (Creative only) ────────────────────────── */
    .studio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .studio-cat {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .studio-cat h4 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--coral);
      margin-bottom: 1rem;
      font-weight: 800;
    }

    .studio-cat ul {
      list-style: none;
      padding: 0;
    }

    .studio-cat li {
      padding: 0.4rem 0;
      color: var(--text-dim);
      border-bottom: 1px dashed var(--border);
      font-size: 0.95rem;
    }

    .studio-cat li:last-child {
      border-bottom: none;
    }

    /* ─── Garden (Garden theme only) ────────────────────── */
    .garden-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }

    .plant-card {
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      transition: all 0.3s;
      position: relative;
    }

    .plant-card:hover {
      transform: translateY(-4px);
      border-color: var(--forest);
      box-shadow: 0 12px 32px rgba(107, 142, 35, 0.15);
    }

    .plant-icon {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 0.75rem;
    }

    .plant-name {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 700;
      line-height: 1.1;
      color: var(--text);
    }

    .plant-variety {
      font-style: italic;
      color: var(--text-dim);
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }

    .plant-status {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.7rem;
      border-radius: 10px;
      margin-bottom: 0.85rem;
      border: 1px solid;
    }

    .plant-status.seedling { background: rgba(132, 204, 22, 0.15); color: #65a30d; border-color: #65a30d; }
    .plant-status.growing { background: rgba(107, 142, 35, 0.15); color: #6b8e23; border-color: #6b8e23; }
    .plant-status.flowering { background: rgba(236, 72, 153, 0.15); color: #db2777; border-color: #db2777; }
    .plant-status.harvesting { background: rgba(201, 123, 76, 0.18); color: #b85c2a; border-color: #b85c2a; }
    .plant-status.established { background: rgba(212, 160, 23, 0.18); color: #b88b1a; border-color: #b88b1a; }
    .plant-status.dormant { background: rgba(120, 113, 108, 0.18); color: #78716c; border-color: #78716c; }

    .plant-note {
      color: var(--text-dim);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .garden-footnote {
      margin-top: 2rem;
      text-align: center;
      font-style: italic;
      color: var(--text-dim);
      font-size: 0.8rem;
    }

    /* Seasonal calendar (Gantt) */
    .cal {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .cal-row {
      display: grid;
      grid-template-columns: 130px repeat(12, 1fr);
      gap: 4px;
      align-items: center;
    }

    .cal-head .cal-month {
      text-align: center;
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--text-dim);
      letter-spacing: 0.1em;
      padding: 0.4rem 0;
    }

    .cal-head .cal-month.current {
      color: var(--coral);
    }

    .cal-label {
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      padding-right: 0.5rem;
    }

    .cal-bar {
      color: #fff;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.55rem 0.7rem;
      border-radius: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: 0.01em;
    }

    .cal-bar.growing { background: linear-gradient(90deg, #6b8e23, #84a02e); }
    .cal-bar.harvesting { background: linear-gradient(90deg, #c97b4c, #d99a6c); }
    .cal-bar.flowering { background: linear-gradient(90deg, #db2777, #e75aa0); }
    .cal-bar.established { background: linear-gradient(90deg, #b88b1a, #d4a017); }

    /* Harvest log */
    .harvest-list {
      max-width: 720px;
      margin: 0 auto;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }

    .harvest-row {
      display: grid;
      grid-template-columns: 90px 1fr auto;
      gap: 1.25rem;
      align-items: center;
      padding: 0.9rem 1.5rem;
      border-bottom: 1px dashed var(--border);
      font-size: 0.95rem;
    }

    .harvest-row:last-child {
      border-bottom: none;
    }

    .harvest-date {
      font-family: var(--font-heading);
      font-style: italic;
      color: var(--coral);
      font-weight: 700;
    }

    .harvest-what {
      color: var(--text);
    }

    .harvest-amt {
      font-family: var(--font-mono);
      color: var(--text-dim);
      font-size: 0.85rem;
      font-weight: 700;
    }

    /* Observations (field notes) */
    .obs-list {
      max-width: 720px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .obs {
      background: var(--bg-light);
      border-left: 4px solid var(--forest);
      border-radius: 4px 12px 12px 4px;
      padding: 1.25rem 1.75rem;
      position: relative;
    }

    .obs-date {
      font-family: var(--font-heading);
      font-style: italic;
      color: var(--coral);
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
    }

    .obs p {
      color: var(--text);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    @media (max-width: 720px) {
      .cal-row {
        grid-template-columns: 80px repeat(12, 1fr);
      }
      .cal-label { font-size: 0.8rem; }
      .cal-bar { font-size: 0.6rem; padding: 0.35rem 0.4rem; }
      .harvest-row { grid-template-columns: 60px 1fr auto; gap: 0.5rem; }
    }

    /* ─── Journey / Map (Adventure only) ────────────────── */
    .travel-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .travel-stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      text-align: center;
    }

    .travel-stat-num {
      font-family: 'Lora', Georgia, serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text);
    }

    .travel-stat.current .travel-stat-num {
      color: var(--coral);
      font-size: 1.25rem;
    }

    .travel-stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      font-weight: 700;
    }

    .adventure-map {
      width: 100%;
      height: 480px;
      border-radius: 16px;
      border: 2px solid var(--border);
      margin-bottom: 1rem;
      background: var(--bg-light);
    }

    .path-legend {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
      justify-content: center;
    }

    .legend-year {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.4rem 0.85rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }

    .legend-year i {
      width: 18px;
      height: 3px;
      border-radius: 2px;
      background: var(--year-color, var(--forest));
      display: inline-block;
    }

    .legend-year:hover {
      transform: translateY(-1px);
      border-color: var(--year-color, var(--ocean));
    }

    .legend-year.dim {
      opacity: 0.35;
    }

    .adventure-map .leaflet-control-zoom {
      border: 1px solid var(--border) !important;
      border-radius: 8px !important;
      overflow: hidden;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }

    .adventure-map .leaflet-control-zoom a {
      background: var(--bg-card) !important;
      color: var(--text) !important;
      border-bottom: 1px solid var(--border) !important;
      font-weight: 700;
    }

    .adventure-map .leaflet-control-zoom a:hover {
      background: var(--bg-light) !important;
      color: var(--coral) !important;
    }

    .adventure-map .leaflet-control-attribution {
      background: rgba(26, 36, 25, 0.85) !important;
      color: var(--text-dim) !important;
      font-size: 9px !important;
      padding: 2px 6px !important;
    }

    .adventure-map .leaflet-control-attribution a {
      color: var(--text-dim) !important;
    }

    /* Pin styling — kill Leaflet's default white box around divIcons */
    .map-pin {
      background: transparent !important;
      border: none !important;
    }

    .map-pin:hover > div {
      transform: scale(1.18);
      transition: transform 0.15s ease-out;
    }

    @keyframes pinPulseDot {
      0%, 100% { box-shadow: 0 0 0 10px rgba(232, 93, 74, 0.35), 0 2px 6px rgba(0, 0, 0, 0.55); }
      50% { box-shadow: 0 0 0 22px rgba(232, 93, 74, 0), 0 2px 6px rgba(0, 0, 0, 0.55); }
    }

    /* Animated dashes on route segments */
    .adventure-map .route-segment {
      animation: dashFlow 40s linear infinite;
    }

    @keyframes dashFlow {
      to { stroke-dashoffset: -240; }
    }

    .adventure-map .leaflet-popup-content-wrapper {
      background: var(--bg-card);
      color: var(--text);
      border-radius: 12px;
      border: 1px solid var(--border);
