    .business-card::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: radial-gradient(circle, var(--ocean)10, transparent);
      border-radius: 50%;
      transform: translate(-50%, -50%);
