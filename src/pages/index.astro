    // ─── Render: travel stats ────────────────────────────────────────
    function renderTravelStats() {
      const states = new Set(placesData.filter(p => p.country === 'USA').map(p => p.city.split(',')[1]?.trim())).size;
      const countries = new Set(placesData.map(p => p.country).filter(Boolean)).size;
      const current = placesData.find(p => p.current);
      const set = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };
      set('statStates', String(states));
      set('statCountries', String(countries));
      set('statPlaces', String(placesData.length));
      set('statCurrent', current ? `📍 ${current.city.split(',')[0]}` : '📍 —');
    }

    // ─── Render: places guide ────────────────────────────────────────
    function renderPlacesGuide() {
      const grid = document.getElementById('placesGrid');
      if (!grid) return;
      const withGuide = placesData.filter(p => p.guide);
      grid.innerHTML = withGuide.map(p => `
        <div class="place-card" data-place-id="${p.id}">
          <h4>${p.city}</h4>
          <p>${p.guide}</p>
        </div>
      `).join('');
      grid.querySelectorAll<HTMLElement>('.place-card').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.dataset.placeId;
          if (id) openPlaceModal(id);
        });
        el.style.cursor = 'pointer';
      });
    }

    // ─── Place modal ────────────────────────────────────────────────
    function openPlaceModal(placeId: string) {
      const p = placesData.find(x => x.id === placeId);
      if (!p) return;
      const overlay = document.getElementById('pmodalOverlay');
      const photos = document.getElementById('pmodalPhotos');
      const meta = document.getElementById('pmodalMeta');
      const city = document.getElementById('pmodalCity');
      const note = document.getElementById('pmodalNote');
      const fields = document.getElementById('pmodalFields');

      if (photos) {
        const fromSheet = photosData.filter(ph => ph.placeId === p.id);
        const fromPlace = (p.photos || []).map(src => ({ url: normalizePhotoUrl(src), caption: '' }));
        const merged = fromSheet.length ? fromSheet : fromPlace;
        const imgs = merged.length
          ? merged.slice(0, 6).map(ph => `<div class="pmodal-photo"><img src="${escapeHTML(ph.url)}" alt="${escapeHTML(ph.caption || p.city)}" loading="lazy"></div>`)
          : ['', '', ''].map(() => `<div class="pmodal-photo">📷 photo</div>`);
        photos.innerHTML = imgs.join('');
      }
      if (meta) meta.textContent = `${p.date}${p.country ? ' · ' + p.country : ''}${p.current ? ' · here now' : ''}`;
      if (city) city.textContent = p.city;
      if (note) note.textContent = p.note;

      const songs = (p.songs || []).map(id => tracksData.find(t => t.id === id)).filter(Boolean) as Track[];
      const fieldDefs: Array<{ key: keyof Place; label: string; icon: string; value?: string }> = [
        { key: 'eat', label: 'Eat', icon: '🍴' },
        { key: 'drink', label: 'Drink', icon: '🍺' },
        { key: 'coffee', label: 'Coffee', icon: '☕' },
        { key: 'move', label: 'Move', icon: '🥾' },
        { key: 'stay', label: 'Stay', icon: '🛏' },
        { key: 'hiddenGem', label: 'Hidden gem', icon: '🎁' },
        { key: 'skip', label: 'Skip', icon: '🚫' },
        { key: 'strangest', label: 'Strangest thing', icon: '🌙' },
        { key: 'verdict', label: 'Verdict', icon: '🔁' },
        { key: 'guide', label: 'Local guide', icon: '🗺' }
      ];
      const filledFields = fieldDefs.filter(f => p[f.key]);
      const songsField = songs.length
        ? `<div class="pmodal-field"><div class="pmodal-field-label">🎵 Made here</div><div class="pmodal-field-value">${songs.map(s => s!.title).join(' · ')}</div></div>`
        : '';
      if (fields) {
        fields.innerHTML = filledFields.map(f => `
          <div class="pmodal-field">
            <div class="pmodal-field-label">${f.icon} ${f.label}</div>
            <div class="pmodal-field-value">${p[f.key]}</div>
          </div>
        `).join('') + songsField;
      }
      overlay?.classList.add('open');
    }

    function closePlaceModal() {
      document.getElementById('pmodalOverlay')?.classList.remove('open');
    }

    document.getElementById('pmodalClose')?.addEventListener('click', closePlaceModal);
    document.getElementById('pmodalOverlay')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('pmodalOverlay')) closePlaceModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePlaceModal();
    });

    // ─── Render: map ─────────────────────────────────────────────────
    let mapInstance: any = null;
    function initMap() {
      const container = document.getElementById('adventureMap');
      if (!container || typeof (window as any).L === 'undefined') return;
      if (mapInstance) {
        mapInstance.invalidateSize();
        return;
      }
      const L = (window as any).L;
      mapInstance = L.map(container, {
        scrollWheelZoom: false,
        zoomControl: true,
        worldCopyJump: true,
        minZoom: 2
      }).setView([20, 0], 2);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        subdomains: 'abcd',
        maxZoom: 19
      }).addTo(mapInstance);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}{r}.png', {
        attribution: '',
        subdomains: 'abcd',
        maxZoom: 19,
        pane: 'shadowPane'
      }).addTo(mapInstance);

      // Year palette for the route polyline + legend
      const yearColors: Record<number, string> = {
        2019: '#94a3b8', 2020: '#94a3b8', 2021: '#94a3b8', 2022: '#94a3b8',
        2023: '#6b8e4e',
        2024: '#d4a574',
        2025: '#e85d4a',
        2026: '#dc2626'
      };
      const getYear = (d: string): number => {
        const m = d.match(/\d{4}/);
        return m ? parseInt(m[0]) : 2023;
      };

      // Markers
      const markerByYear: Record<number, any[]> = {};
      placesData.forEach(p => {
        const isCurrent = p.current;
        const year = getYear(p.date);
        const color = isCurrent ? '#e85d4a' : (yearColors[year] || '#6b8e4e');
        const dot = isCurrent ? 16 : 12;
        const haloColor = isCurrent ? '232, 93, 74' : '255, 255, 255';
        const haloAlpha = isCurrent ? '0.35' : '0.15';
        const haloSize = isCurrent ? 10 : 6;
        const icon = L.divIcon({
          className: 'map-pin' + (isCurrent ? ' current' : ''),
          html: `<div style="
            width:${dot}px;
            height:${dot}px;
            background:${color};
            border-radius:50%;
            border:2px solid rgba(255,255,255,0.85);
            box-shadow: 0 0 0 ${haloSize}px rgba(${haloColor}, ${haloAlpha}), 0 2px 6px rgba(0, 0, 0, 0.55);
            ${isCurrent ? 'animation: pinPulseDot 2s infinite;' : ''}
          "></div>`,
          iconSize: [dot + haloSize * 2, dot + haloSize * 2],
          iconAnchor: [(dot + haloSize * 2) / 2, (dot + haloSize * 2) / 2]
        });
        const marker = L.marker(p.coords, { icon, riseOnHover: true }).addTo(mapInstance);
        marker.on('click', () => openPlaceModal(p.id));
        (markerByYear[year] ||= []).push(marker);
      });

      // Route polyline — connect pins in their array order (chronological).
      const segmentsByYear: Record<number, any[]> = {};
      for (let i = 0; i < placesData.length - 1; i++) {
        const a = placesData[i];
        const b = placesData[i + 1];
        const year = getYear(b.date);
        const seg = L.polyline([a.coords, b.coords], {
          color: yearColors[year] || '#888',
          weight: 1.6,
          opacity: 0.15,
          dashArray: '5 7',
          className: 'route-segment',
          smoothFactor: 1
        }).addTo(mapInstance);
        (segmentsByYear[year] ||= []).push(seg);
      }

      // Fit the view to all pins so the world view shows on first load.
      const allCoords = placesData.map(p => p.coords);
      if (allCoords.length > 0) {
        mapInstance.fitBounds(allCoords, { padding: [30, 30], maxZoom: 6 });
      }

      // Render the year legend below the map. Clicking a year isolates it.
      const legendEl = document.getElementById('pathLegend');
      if (legendEl) {
        const years = Object.keys(yearColors).map(Number).filter(y => segmentsByYear[y] || markerByYear[y]).sort();
        let activeYear: number | null = null;
        const render = () => {
          legendEl.innerHTML = [
            `<button class="legend-year ${activeYear === null ? '' : 'dim'}" data-year="all" style="--year-color: var(--text-dim)"><i></i>All</button>`,
            ...years.map(y => `<button class="legend-year ${activeYear !== null && activeYear !== y ? 'dim' : ''}" data-year="${y}" style="--year-color: ${yearColors[y]}"><i></i>${y}</button>`)
          ].join('');
          legendEl.querySelectorAll<HTMLButtonElement>('.legend-year').forEach(btn => {
            btn.addEventListener('click', () => {
              const v = btn.dataset.year;
              activeYear = v === 'all' ? null : parseInt(v || '0');
              years.forEach(y => {
                const visible = activeYear === null || activeYear === y;
                (segmentsByYear[y] || []).forEach((s: any) => s.setStyle({ opacity: visible ? 0.55 : 0 }));
                (markerByYear[y] || []).forEach((m: any) => m.setOpacity(visible ? 1 : 0.15));
              });
              render();
            });
          });
        };
        render();
      }
    }

    // ─── Render: catalog ─────────────────────────────────────────────
    let activeFilter = 'all';

    function renderTrackFilters() {
      const wrap = document.getElementById('trackFilters');
      if (!wrap) return;
      const allTags = new Set<string>(['all']);
      tracksData.forEach(t => t.tags.forEach(tag => allTags.add(tag)));
      wrap.innerHTML = Array.from(allTags).map(tag => `
        <button class="track-filter ${tag === activeFilter ? 'active' : ''}" data-filter="${tag}">${tag}</button>
      `).join('');
      wrap.querySelectorAll<HTMLButtonElement>('.track-filter').forEach(btn => {
        btn.addEventListener('click', () => {
          activeFilter = btn.dataset.filter || 'all';
          renderTrackFilters();
          renderTracks();
        });
      });
    }

    function renderTracks() {
      const list = document.getElementById('tracksList');
      if (!list) return;
      const filtered = activeFilter === 'all'
        ? tracksData
        : tracksData.filter(t => t.tags.includes(activeFilter));
      list.innerHTML = filtered.map((t, i) => {
        const place = t.placeId ? placesData.find(p => p.id === t.placeId) : null;
        const placeTag = place ? `<span class="track-meta-tag place">📍 ${place.city.split(',')[0]}</span>` : '';
        const bpmTag = t.bpm ? `<span class="track-meta-tag">${t.bpm} BPM</span>` : '';
        const keyTag = t.musicalKey ? `<span class="track-meta-tag">${t.musicalKey}</span>` : '';
        const tagPills = t.tags.map(tag => `<span class="track-meta-tag">${tag}</span>`).join('');
        const status = t.status ? `<span class="track-status">${t.status}</span>` : '';
        return `
          <div class="track-row">
            <div class="track-num">${String(i + 1).padStart(2, '0')}</div>
            <div class="track-main">
              <div class="track-title">${t.title}</div>
              <div class="track-meta">${bpmTag}${keyTag}${placeTag}${tagPills}</div>
            </div>
            <div class="track-actions">
              ${status}
              <button class="track-play" aria-label="Play ${t.title}">▶</button>
            </div>
          </div>
        `;
      }).join('');
    }

    // ─── Render: videos ──────────────────────────────────────────────
    function renderVideos() {
      const grid = document.getElementById('videosGrid');
      if (!grid) return;
      grid.innerHTML = videosData.map(v => `
        <div class="video-card">
          <div class="video-thumb">
            ${v.youtubeId
              ? `<iframe src="https://www.youtube.com/embed/${v.youtubeId}" allowfullscreen></iframe>`
              : `🎬`}
          </div>
          <div class="video-info">
            <div class="video-title">${v.title}</div>
            <div class="video-date">${v.date}</div>
          </div>
        </div>
      `).join('');
    }

    // Render everything that's data-driven once at load
    renderTravelStats();
    renderPlacesGuide();
    renderTrackFilters();
    renderTracks();
    renderVideos();

    // Try to pull fresher places from the Google Sheet (if configured).
    // If successful, re-render stats + guide and rebuild map markers.
    loadPlacesFromSheet().then(loaded => {
      if (!loaded) return;
      renderTravelStats();
      renderPlacesGuide();
      if (mapInstance) {
        mapInstance.remove();
        mapInstance = null;
        if (document.body.getAttribute('data-theme') === 'adventure') {
          requestAnimationFrame(() => initMap());
        }
      }
    });

    // Live-sync the other live data sections from their Google Sheets.
    syncFestivals();
    syncParks();
    syncBucket();
    syncFinance();
    syncRoutines();
    syncNotebook();
    syncPhotos();

    // Map pulse keyframe (injected once)
    const styleEl = document.createElement('style');
    styleEl.textContent = '@keyframes mapPulse { 0%,100% { box-shadow: 0 0 0 4px rgba(232,93,74,0.25), 0 2px 8px rgba(0,0,0,0.4); } 50% { box-shadow: 0 0 0 12px rgba(232,93,74,0); 0 2px 8px rgba(0,0,0,0.4); } }';
    document.head.appendChild(styleEl);

    // ─── Theme configuration ─────────────────────────────────────────
    // Each theme defines: section order, hero copy, optional hidden sections.
    interface ThemeConfig {
      order: string[];
      subtitle: string;
      bio: string;
      badge: string;
    }

    // Section IDs that may be present. Visibility is driven entirely by config.order.
    const ALL_SECTIONS = ['now', 'businesses', 'projects', 'music', 'contact', 'picks', 'portfolio', 'dispatches', 'studio', 'journey', 'tracks', 'videos', 'garden', 'calendar', 'harvest', 'observations', 'press', 'manifesto', 'stack', 'faq', 'why-healthcare', 'album', 'nowplaying', 'letter', 'charts', 'bucket', 'pack', 'zoo', 'numbers', 'decisions', 'rig', 'parks', 'fests', 'practice', 'routines', 'notebook', 'rehab-tech'];

    const themes: Record<string, ThemeConfig> = {
      midnight: {
        order: ['now', 'businesses', 'projects', 'zoo', 'stack', 'nowplaying', 'faq', 'music', 'contact'],
        subtitle: 'AI Engineer. Founder. Researcher.',
        bio: 'I build production AI agents in Python, FastAPI, and LangGraph. Currently looking for roles in AI agents, healthcare tech, and AI research.',
        badge: 'Open to work — AI Engineer / Research'
      },
      cream: {
        order: ['nowplaying', 'music', 'now', 'businesses', 'projects', 'contact'],
        subtitle: 'Builder. Maker. Tinkerer.',
        bio: 'I build things. AI agents, music, side projects, startups. This is a slower, warmer corner of the internet — poke around.',
        badge: 'Open to interesting conversations'
      },
      healthcare: {
        order: ['why-healthcare', 'zoo', 'now', 'projects', 'businesses', 'faq', 'contact', 'music'],
        subtitle: 'AI Engineer building healthcare technology.',
        bio: 'Production AI agents for clinical workflows. Background spans PwC enterprise AI, real-time biosignal processing, and time in clinical settings — focused on tools that fit how medicine is actually practiced.',
        badge: 'Open to work — Healthcare AI / Clinical Tech'
      },
      adventure: {
        order: ['journey', 'rig', 'fests', 'zoo', 'parks', 'bucket', 'album', 'dispatches', 'pack', 'now', 'music', 'businesses', 'projects', 'contact'],
        subtitle: 'Builder. Wanderer. Storyteller.',
        bio: 'I build software between trail miles and time zones. The best ideas tend to show up somewhere with no service — these are the ones I brought back.',
        badge: 'Currently — building from the road'
      },
      creative: {
        order: ['music', 'tracks', 'nowplaying', 'videos', 'zoo', 'studio', 'projects', 'businesses', 'now', 'contact'],
        subtitle: 'Producer. Engineer. Artist.',
        bio: 'I make music and the tools to make music with. Audio ML, generative systems, and live performance — the rest of the stack is in service of that.',
        badge: 'Open to creative collaborations'
      },
      agents: {
        order: ['zoo', 'projects', 'stack', 'now', 'businesses', 'faq', 'contact'],
        subtitle: 'AI Agent Engineer.',
        bio: 'I ship production multi-step agents — LangGraph, FastAPI, persistent memory, evaluation harnesses, adversarial testing. Reliability over demos.',
        badge: 'Open to work — Agent Infrastructure / Platform'
      },
      cyber: {
        order: ['projects', 'zoo', 'stack', 'now', 'businesses', 'faq', 'contact'],
        subtitle: 'AI Security Researcher.',
        bio: 'I red-team AI agents. Octagon explores RL-driven attack policies against agent stacks. PwC background in compliance and risk underwrites the rigor.',
        badge: 'Open to work — AI Security / Red Team'
      },
      finance: {
        order: ['now', 'portfolio', 'charts', 'zoo', 'letter', 'picks', 'projects', 'businesses', 'faq', 'contact'],
        subtitle: 'AI Engineer. Quant-Curious. Former PwC.',
        bio: 'Finance + CS undergrad, PwC Innovation Hub alum building AI for banking clients. Comfortable shipping production systems against regulated environments and senior-stakeholder review cycles.',
        badge: 'Open to work — AI in Financial Services'
      },
      founder: {
        order: ['businesses', 'numbers', 'press', 'decisions', 'manifesto', 'zoo', 'projects', 'now', 'faq', 'contact'],
        subtitle: 'Founder. Builder. Operator.',
        bio: 'Three ventures in motion — Boundless Horizons (stealth), TM Go (tour management), SelfNVest AI (FSBO real estate). Full-stack, from schema to UI to DNS. I ship.',
        badge: 'Open to founder / co-founder conversations'
      },
      garden: {
        order: ['garden', 'calendar', 'harvest', 'observations', 'now', 'projects', 'businesses', 'contact'],
        subtitle: 'Gardener. Grower. Patient about it.',
        bio: 'Slow projects. Plants, compost, observation. The garden teaches you to plan in seasons, not sprints — every other project I work on borrows that rhythm.',
        badge: 'Currently — tending the plot'
      },
      wellness: {
        order: ['practice', 'routines', 'notebook', 'rehab-tech', 'zoo', 'now', 'projects', 'contact'],
        subtitle: 'Practitioner. Teacher. Self-experimenter.',
        bio: "Yoga teacher, alt-medicine-curious, self-trained on my own anatomy. I write about what I try, what works, and what I don't know — empirical wellness, no snake oil.",
        badge: 'Open to teaching + collaborations'
      }
    };

    const layout = document.getElementById('layout');
    const subtitleEl = document.getElementById('heroSubtitle');
    const bioEl = document.getElementById('heroBio');
    const badgeEl = document.getElementById('openToWork');

    function applyTheme(theme: string) {
      const config = themes[theme] || themes.midnight;
      document.body.setAttribute('data-theme', theme);

      // Keep the URL in sync so the current view is always shareable.
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('theme', theme);
        history.replaceState({}, '', url.toString());
      } catch {}

      if (subtitleEl) subtitleEl.textContent = config.subtitle;
      if (bioEl) bioEl.textContent = config.bio;
      if (badgeEl) badgeEl.textContent = config.badge;

      if (layout) {
        // Hide every section by default — config.order is the source of truth for what's shown.
        ALL_SECTIONS.forEach(id => {
          const el = document.getElementById(id);
          if (el) el.style.display = 'none';
        });
        config.order.forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            el.style.display = '';
            layout.appendChild(el);
          }
        });
      }

      // Per-card visibility: data-theme-only="founder,finance" shows only on those themes.
      document.querySelectorAll<HTMLElement>('[data-theme-only]').forEach(el => {
        const list = (el.dataset.themeOnly || '').split(',').map(s => s.trim());
        el.style.display = list.includes(theme) ? '' : 'none';
      });

      // Re-apply current project filter (respects theme-only too).
      applyProjectFilter(activeProjectFilter);

      document.querySelectorAll<HTMLElement>('.theme-option').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.setTheme === theme);
      });

      // Adventure map needs init/resize once its container becomes visible.
      if (theme === 'adventure') {
        requestAnimationFrame(() => initMap());
      }

      // Cyber matrix rain canvas
      if (theme === 'cyber') startMatrix();
      else stopMatrix();
    }

    // ─── Cyber: matrix rain ─────────────────────────────
    const matrixCanvas = document.getElementById('matrixCanvas') as HTMLCanvasElement | null;
    let matrixRaf: number | null = null;
    let matrixDrops: number[] = [];

    function startMatrix() {
      if (!matrixCanvas || matrixRaf) return;
      const ctx = matrixCanvas.getContext('2d');
      if (!ctx) return;
      matrixCanvas.width = window.innerWidth;
      matrixCanvas.height = window.innerHeight;
      const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789';
      const fontSize = 14;
      const cols = Math.floor(matrixCanvas.width / fontSize);
      matrixDrops = new Array(cols).fill(1).map(() => Math.random() * matrixCanvas!.height / fontSize);
      const tick = () => {
        if (!matrixCanvas) return;
        ctx.fillStyle = 'rgba(10, 15, 10, 0.06)';
        ctx.fillRect(0, 0, matrixCanvas.width, matrixCanvas.height);
        ctx.fillStyle = '#00ff41';
        ctx.font = `${fontSize}px monospace`;
        for (let i = 0; i < matrixDrops.length; i++) {
          const c = chars[Math.floor(Math.random() * chars.length)];
          ctx.fillText(c, i * fontSize, matrixDrops[i] * fontSize);
          if (matrixDrops[i] * fontSize > matrixCanvas.height && Math.random() > 0.975) matrixDrops[i] = 0;
          matrixDrops[i]++;
        }
        matrixRaf = requestAnimationFrame(tick);
      };
      tick();
    }

    function stopMatrix() {
      if (matrixRaf) { cancelAnimationFrame(matrixRaf); matrixRaf = null; }
      if (matrixCanvas) {
        const ctx = matrixCanvas.getContext('2d');
        ctx?.clearRect(0, 0, matrixCanvas.width, matrixCanvas.height);
      }
    }

    window.addEventListener('resize', () => {
      if (matrixCanvas && matrixRaf) {
        matrixCanvas.width = window.innerWidth;
        matrixCanvas.height = window.innerHeight;
      }
    });

    // ─── Project filter (Midnight only — other themes hide the filter UI) ──
    // Defined BEFORE applyTheme is called so the in-applyTheme call doesn't throw.
    let activeProjectFilter = 'all';

    function applyProjectFilter(category: string) {
      activeProjectFilter = category;
      const theme = document.body.getAttribute('data-theme') || 'midnight';
      document.querySelectorAll<HTMLElement>('#projects .project-card').forEach(card => {
        const cats = (card.dataset.category || '').split(',').map(s => s.trim());
        const themes = card.dataset.themeOnly ? card.dataset.themeOnly.split(',').map(s => s.trim()) : null;
        const themeOk = !themes || themes.includes(theme);
        const catOk = category === 'all' || cats.includes(category);
        card.style.display = (themeOk && catOk) ? '' : 'none';
      });
      document.querySelectorAll<HTMLElement>('#projectFilters .project-filter').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === category);
      });
    }

    document.querySelectorAll<HTMLElement>('#projectFilters .project-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        applyProjectFilter(btn.dataset.filter || 'all');
      });
    });

    // Theme resolution priority: URL ?theme=X → localStorage → midnight
    const urlTheme = new URLSearchParams(window.location.search).get('theme');
    const savedTheme = (urlTheme && themes[urlTheme]) ? urlTheme : (localStorage.getItem('theme') || 'midnight');
    applyTheme(savedTheme);
    if (urlTheme && themes[urlTheme]) localStorage.setItem('theme', urlTheme);

    const settingsBtn = document.getElementById('settingsBtn');
    const settingsPanel = document.getElementById('settingsPanel');

    settingsBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      settingsPanel?.classList.toggle('open');
    });

    document.addEventListener('click', (e) => {
      if (!settingsPanel?.contains(e.target as Node) && e.target !== settingsBtn) {
        settingsPanel?.classList.remove('open');
      }
    });

    document.querySelectorAll<HTMLElement>('.theme-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.dataset.setTheme;
        if (!theme) return;
        localStorage.setItem('theme', theme);
        applyTheme(theme);
      });
    });

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Intersection Observer for fade-in
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          target.style.opacity = '1';
          target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -100px 0px' });

    document.querySelectorAll<HTMLElement>('.business-card, .project-card, .now-card, .music-card').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = 'opacity 0.6s, transform 0.6s';
      observer.observe(el);
    });

    // (Project filter logic moved above applyTheme so it's defined when applyTheme first runs.)

    // ─── Cmd+K command palette ─────────────────────────────
    interface CmdItem {
      id: string;
      title: string;
      kind: string;
      icon: string;
      exec: () => void;
    }

    function buildCmdItems(): CmdItem[] {
      const items: CmdItem[] = [];
      const themeLabels: Record<string, string> = {
        midnight: 'Midnight', cream: 'Cream', healthcare: 'Healthcare',
        adventure: 'Adventure', creative: 'Creative', agents: 'AI Agents',
        cyber: 'Cyber Risk', finance: 'Finance', founder: 'Founder', garden: 'Garden'
      };
      Object.keys(themes).forEach(t => {
        items.push({
          id: `theme:${t}`,
          title: `Switch to ${themeLabels[t] || t}`,
          kind: 'Theme',
          icon: '🎨',
          exec: () => { localStorage.setItem('theme', t); applyTheme(t); }
        });
      });
      const sectionLabels: Record<string, string> = {
        now: 'Now', businesses: 'Ventures', projects: 'Projects', music: 'Music',
        contact: 'Contact', picks: 'My Picks', portfolio: 'Portfolio',
        dispatches: 'Dispatches', studio: 'Studio', journey: 'Journey',
        tracks: 'Catalog', videos: 'Videos', garden: 'The Garden',
        calendar: 'Seasonal Calendar', harvest: 'Harvest Log', observations: 'Field Notes',
        press: 'As Not Featured In', manifesto: 'Manifesto',
        stack: 'Stack', faq: 'FAQ', 'why-healthcare': 'Why Healthcare', album: 'Album',
        nowplaying: 'What I\'m Into',
        letter: 'Quarterly Letter', charts: 'Charts I Made',
        bucket: 'Bucket List', pack: 'What I Pack', zoo: 'Agent Zoo',
        numbers: 'The Numbers', decisions: 'Decisions Log',
        rig: 'The Rig', parks: 'National Parks', fests: 'Festivals',
        practice: 'The Practice', routines: 'Routines', notebook: 'Notebook', 'rehab-tech': 'Rehab Tech'
      };
      Object.entries(sectionLabels).forEach(([id, label]) => {
        items.push({
          id: `nav:${id}`,
          title: `Go to ${label}`,
          kind: 'Navigate',
          icon: '↓',
          exec: () => document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
        });
      });
      items.push(
        { id: 'resume', title: 'Download Resume', kind: 'Action', icon: '📄', exec: () => window.open('/RESUME_2026.pdf', '_blank') },
        { id: 'github', title: 'Open GitHub', kind: 'Action', icon: '⌗', exec: () => window.open('https://github.com/anafe03', '_blank') },
        { id: 'linkedin', title: 'Open LinkedIn', kind: 'Action', icon: '⌬', exec: () => window.open('https://www.linkedin.com/in/austinnafe/', '_blank') },
        { id: 'email', title: 'Email Austin', kind: 'Action', icon: '✉', exec: () => { window.location.href = 'mailto:austinnafe@aol.com'; } },
        { id: 'soundcloud', title: 'Open SoundCloud', kind: 'Action', icon: '♪', exec: () => window.open('https://soundcloud.com/user-611195779', '_blank') },
        { id: 'copy-url', title: 'Copy shareable link for current theme', kind: 'Action', icon: '🔗', exec: () => navigator.clipboard.writeText(window.location.href) }
      );
      return items;
    }

    const cmdItems = buildCmdItems();
    let cmdFilter = '';
    let cmdIndex = 0;
    const cmdOverlay = document.getElementById('cmdkOverlay');
    const cmdInput = document.getElementById('cmdkInput') as HTMLInputElement | null;
    const cmdList = document.getElementById('cmdkList');

    function cmdFiltered() {
      const q = cmdFilter.toLowerCase().trim();
      if (!q) return cmdItems;
      return cmdItems.filter(i => i.title.toLowerCase().includes(q) || i.kind.toLowerCase().includes(q));
    }

    function renderCmd() {
      if (!cmdList) return;
      const filtered = cmdFiltered();
      if (filtered.length === 0) {
        cmdList.innerHTML = `<div class="cmdk-item"><span class="cmdk-item-icon">⊘</span><span class="cmdk-item-title">No matches</span><span class="cmdk-item-kind"></span></div>`;
        return;
      }
      cmdIndex = Math.min(cmdIndex, filtered.length - 1);
      cmdList.innerHTML = filtered.map((i, idx) => `
        <div class="cmdk-item ${idx === cmdIndex ? 'active' : ''}" data-cmd="${i.id}">
          <span class="cmdk-item-icon">${i.icon}</span>
          <span class="cmdk-item-title">${i.title}</span>
          <span class="cmdk-item-kind">${i.kind}</span>
        </div>
      `).join('');
      cmdList.querySelectorAll<HTMLElement>('.cmdk-item').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.dataset.cmd;
          const item = cmdItems.find(i => i.id === id);
          if (item) { item.exec(); closeCmd(); }
        });
      });
    }

    function openCmd() {
      if (!cmdOverlay) return;
      cmdOverlay.classList.add('open');
      cmdFilter = '';
      cmdIndex = 0;
      if (cmdInput) { cmdInput.value = ''; setTimeout(() => cmdInput.focus(), 50); }
      renderCmd();
    }

    function closeCmd() {
      cmdOverlay?.classList.remove('open');
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (cmdOverlay?.classList.contains('open')) closeCmd();
        else openCmd();
        return;
      }
      if (!cmdOverlay?.classList.contains('open')) return;
      if (e.key === 'Escape') { e.preventDefault(); closeCmd(); }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const f = cmdFiltered();
        cmdIndex = (cmdIndex + 1) % Math.max(1, f.length);
        renderCmd();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        const f = cmdFiltered();
        cmdIndex = (cmdIndex - 1 + f.length) % Math.max(1, f.length);
        renderCmd();
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        const f = cmdFiltered();
        if (f[cmdIndex]) { f[cmdIndex].exec(); closeCmd(); }
      }
    });

    cmdInput?.addEventListener('input', () => {
      cmdFilter = cmdInput.value;
      cmdIndex = 0;
      renderCmd();
    });

    cmdOverlay?.addEventListener('click', (e) => {
      if (e.target === cmdOverlay) closeCmd();
    });
  </script>
</body>
</html>