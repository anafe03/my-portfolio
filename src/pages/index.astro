---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Austin Nafe - Builder & Creator</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root,
    [data-theme="midnight"] {
      --forest: #2d5016;
      --ocean: #0077be;
      --coral: #ff6b6b;
      --bg: #0a0e27;
      --bg-light: #1a1f3a;
      --bg-card: #252b4a;
      --text: #e8eef7;
      --text-dim: #8b95b0;
      --border: #2d3557;
      --nav-bg: rgba(10, 14, 39, 0.8);
    }

    [data-theme="cream"] {
      --forest: #c4621a;
      --ocean: #e8651c;
      --coral: #d94a0f;
      --bg: #f5efe0;
      --bg-light: #faf6ec;
      --bg-card: #ffffff;
      --text: #2a1f10;
      --text-dim: #6b5d4a;
      --border: #e3d6b8;
      --nav-bg: rgba(245, 239, 224, 0.85);
    }

    [data-theme="healthcare"] {
      --forest: #14b8a6;
      --ocean: #0ea5e9;
      --coral: #f87171;
      --bg: #f0f7fa;
      --bg-light: #ffffff;
      --bg-card: #ffffff;
      --text: #0f2740;
      --text-dim: #5a7080;
      --border: #d6e3ea;
      --nav-bg: rgba(240, 247, 250, 0.85);
    }

    [data-theme="adventure"] {
      --forest: #6b8e4e;
      --ocean: #d4a574;
      --coral: #e85d4a;
      --bg: #1a2419;
      --bg-light: #2a3a28;
      --bg-card: #354733;
      --text: #f5f1e8;
      --text-dim: #a8b09e;
      --border: #4a5d47;
      --nav-bg: rgba(26, 36, 25, 0.85);
    }

    [data-theme="creative"] {
      --forest: #ec4899;
      --ocean: #8b5cf6;
      --coral: #fbbf24;
      --bg: #1a0b2e;
      --bg-light: #2d1457;
      --bg-card: #3d1f6b;
      --text: #faf3ff;
      --text-dim: #b39ddb;
      --border: #4a2b7a;
      --nav-bg: rgba(26, 11, 46, 0.85);
    }

    [data-theme="agents"] {
      --forest: #00d9b2;
      --ocean: #3b82f6;
      --coral: #c084fc;
      --bg: #050817;
      --bg-light: #0e1530;
      --bg-card: #161e3d;
      --text: #e2f3ff;
      --text-dim: #6b8aae;
      --border: #1f2d50;
      --nav-bg: rgba(5, 8, 23, 0.85);
    }

    [data-theme="cyber"] {
      --forest: #00ff41;
      --ocean: #ff003c;
      --coral: #ffb700;
      --bg: #0a0f0a;
      --bg-light: #131a13;
      --bg-card: #1a241a;
      --text: #d8ffd8;
      --text-dim: #6b8c6b;
      --border: #2a3a2a;
      --nav-bg: rgba(10, 15, 10, 0.85);
    }

    [data-theme="finance"] {
      --forest: #d4af37;
      --ocean: #2d8659;
      --coral: #b08d57;
      --bg: #0c1419;
      --bg-light: #16222b;
      --bg-card: #1e2d39;
      --text: #f0e9d2;
      --text-dim: #8a9aa8;
      --border: #2a3d4d;
      --nav-bg: rgba(12, 20, 25, 0.85);
    }

    [data-theme="founder"] {
      --forest: #dc2626;
      --ocean: #0a0a0a;
      --coral: #f59e0b;
      --bg: #ffffff;
      --bg-light: #fafafa;
      --bg-card: #ffffff;
      --text: #0a0a0a;
      --text-dim: #525252;
      --border: #e5e5e5;
      --nav-bg: rgba(255, 255, 255, 0.9);
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: var(--text);
      background: var(--bg);
      overflow-x: hidden;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    nav {
      padding: 1.5rem 0;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: var(--nav-bg);
      backdrop-filter: blur(20px);
      z-index: 100;
      border-bottom: 1px solid var(--border);
    }

    nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--text);
      text-decoration: none;
    }

    nav ul {
      display: flex;
      gap: 2.5rem;
      list-style: none;
      align-items: center;
    }

    nav a {
      color: var(--text-dim);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s;
      position: relative;
    }

    nav a::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 0;
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--forest), var(--ocean), var(--coral));
      transition: width 0.3s;
    }

    nav a:hover {
      color: var(--text);
    }

    nav a:hover::after {
      width: 100%;
    }

    .hero {
      padding: 12rem 0 8rem;
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      display: flex;
      align-items: center;
    }

    .floating-shape {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      opacity: 0.3;
      animation: float 20s infinite ease-in-out;
    }

    .shape-1 {
      width: 400px;
      height: 400px;
      background: var(--forest);
      top: 10%;
      right: 10%;
    }

    .shape-2 {
      width: 300px;
      height: 300px;
      background: var(--ocean);
      bottom: 20%;
      left: 5%;
      animation-delay: 5s;
    }

    .shape-3 {
      width: 350px;
      height: 350px;
      background: var(--coral);
      top: 50%;
      left: 50%;
      animation-delay: 10s;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(30px, -30px) rotate(90deg); }
      50% { transform: translate(-20px, 20px) rotate(180deg); }
      75% { transform: translate(40px, 10px) rotate(270deg); }
    }

    .hero .container {
      position: relative;
      z-index: 1;
    }

    .hero-content {
      display: flex;
      align-items: center;
      gap: 4rem;
    }

    .hero-text {
      flex: 1;
    }

    .hero-image {
      width: 300px;
      height: 300px;
      border-radius: 50%;
      padding: 4px;
      background: linear-gradient(135deg, var(--forest), var(--ocean), var(--coral));
      animation: float 6s infinite ease-in-out;
      box-shadow: 0 20px 60px rgba(0, 119, 190, 0.4);
      flex-shrink: 0;
    }

    .hero-image img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      display: block;
    }

    .open-to-work {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 1rem;
      background: rgba(45, 80, 22, 0.15);
      border: 1px solid var(--forest);
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #6fcf97;
      margin-bottom: 1.25rem;
      animation: slideUp 0.8s ease-out;
    }

    .open-to-work::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #6fcf97;
      box-shadow: 0 0 10px #6fcf97;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .now-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .now-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.75rem;
      transition: all 0.3s;
    }

    .now-card:hover {
      border-color: var(--ocean);
      transform: translateY(-4px);
    }

    .now-card .now-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--coral);
      margin-bottom: 0.5rem;
    }

    .now-card h4 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .now-card p {
      font-size: 0.95rem;
      color: var(--text-dim);
      line-height: 1.6;
    }

    /* ─── Boundless Horizons (Founder only) ─────────────── */
    .business-card.boundless {
      background: linear-gradient(135deg, var(--bg-light), var(--bg-card));
      position: relative;
    }

    .business-card.boundless::before {
      transform: scaleX(1);
    }

    .business-card.boundless h3 {
      font-family: var(--font-serif, Georgia, serif);
      font-size: 2rem;
      letter-spacing: -0.02em;
    }

    /* ─── My Picks (Finance only) ───────────────────────── */
    .picks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .pick-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      transition: all 0.3s;
    }

    .pick-card:hover {
      transform: translateY(-4px);
      border-color: var(--forest);
    }

    .pick-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .pick-ticker {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 0.05em;
      color: var(--text);
    }

    .pick-conviction {
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
    }

    .pick-conviction.long {
      background: rgba(45, 134, 89, 0.15);
      color: #4ade80;
      border: 1px solid #4ade80;
    }

    .pick-conviction.watch {
      background: rgba(212, 175, 55, 0.15);
      color: #d4af37;
      border: 1px solid #d4af37;
    }

    .pick-conviction.avoid {
      background: rgba(220, 38, 38, 0.15);
      color: #f87171;
      border: 1px solid #f87171;
    }

    .pick-card h4 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .pick-card p {
      font-size: 0.9rem;
      color: var(--text-dim);
      line-height: 1.6;
    }

    /* ─── Portfolio (Finance only) ──────────────────────── */
    .portfolio-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .stat-tile {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding: 0.5rem 1rem;
      border-right: 1px solid var(--border);
    }

    .stat-tile:last-child {
      border-right: none;
    }

    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      font-weight: 700;
    }

    .stat-value {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .stat-value.positive { color: #4ade80; }
    .stat-value.negative { color: #f87171; }

    .positions-table {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }

    .position-row {
      display: grid;
      grid-template-columns: 90px 80px 80px 90px 1fr;
      gap: 1rem;
      padding: 1rem 1.5rem;
      align-items: center;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
    }

    .position-row:last-child {
      border-bottom: none;
    }

    .position-row:not(.position-head):hover {
      background: var(--bg-card);
    }

    .position-head {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-dim);
      font-weight: 800;
      background: var(--bg-card);
    }

    .position-ticker {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text);
    }

    .position-alloc, .position-entry {
      font-family: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace;
      color: var(--text-dim);
    }

    .position-thesis {
      color: var(--text-dim);
      line-height: 1.5;
    }

    .portfolio-footnote {
      margin-top: 1.25rem;
      font-size: 0.75rem;
      color: var(--text-dim);
      font-style: italic;
      text-align: center;
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    @media (max-width: 720px) {
      .position-row {
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
      }
      .position-row.position-head { display: none; }
      .position-thesis { grid-column: 1 / -1; font-size: 0.85rem; }
      .stat-tile { border-right: none; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }
      .stat-tile:last-child { border-bottom: none; }
    }

    /* ─── Dispatches (Adventure only) ───────────────────── */
    .dispatches-list {
      display: grid;
      gap: 1.5rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .dispatch {
      background: var(--bg-light);
      border-left: 4px solid var(--forest);
      border-radius: 4px 16px 16px 4px;
      padding: 1.5rem 2rem;
      transition: all 0.3s;
    }

    .dispatch:hover {
      transform: translateX(6px);
      border-left-color: var(--coral);
    }

    .dispatch-meta {
      display: flex;
      gap: 1rem;
      font-size: 0.8rem;
      color: var(--text-dim);
      margin-bottom: 0.5rem;
      font-family: 'Lora', Georgia, serif;
      font-style: italic;
    }

    .dispatch-date {
      font-weight: 700;
      color: var(--coral);
    }

    .dispatch h4 {
      font-family: 'Lora', Georgia, serif;
      font-size: 1.4rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }

    .dispatch p {
      color: var(--text-dim);
      line-height: 1.7;
    }

    /* ─── Studio (Creative only) ────────────────────────── */
    .studio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .studio-cat {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
    }

    .studio-cat h4 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--coral);
      margin-bottom: 1rem;
      font-weight: 800;
    }

    .studio-cat ul {
      list-style: none;
      padding: 0;
    }

    .studio-cat li {
      padding: 0.4rem 0;
      color: var(--text-dim);
      border-bottom: 1px dashed var(--border);
      font-size: 0.95rem;
    }

    .studio-cat li:last-child {
      border-bottom: none;
    }

    .hero h1 {
      font-size: 5rem;
      font-weight: 900;
      margin-bottom: 1rem;
      line-height: 1;
      background: linear-gradient(135deg, var(--forest), var(--ocean), var(--coral));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: slideUp 0.8s ease-out;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero .subtitle {
      font-size: 1.8rem;
      color: var(--text-dim);
      margin-bottom: 2rem;
      animation: slideUp 0.8s ease-out 0.2s backwards;
    }

    .hero .bio {
      font-size: 1.2rem;
      color: var(--text-dim);
      margin-bottom: 3rem;
      line-height: 1.8;
      animation: slideUp 0.8s ease-out 0.4s backwards;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      animation: slideUp 0.8s ease-out 0.6s backwards;
    }

    .btn {
      padding: 1rem 2.5rem;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 700;
      transition: all 0.3s;
      display: inline-block;
      border: 2px solid transparent;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      transition: width 0.6s, height 0.6s;
      transform: translate(-50%, -50%);
    }

    .btn:hover::before {
      width: 300px;
      height: 300px;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--forest), var(--ocean));
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(0, 119, 190, 0.4);
    }

    .btn-secondary {
      background: transparent;
      color: var(--coral);
      border-color: var(--coral);
    }

    .btn-secondary:hover {
      background: var(--coral);
      color: white;
      transform: translateY(-3px);
    }

    section {
      padding: 6rem 0;
      position: relative;
    }

    .section-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .section-header h2 {
      font-size: 3rem;
      font-weight: 900;
      margin-bottom: 1rem;
      display: inline-block;
      position: relative;
    }

    .section-header h2::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--forest), var(--ocean), var(--coral));
      border-radius: 2px;
    }

    .section-header p {
      font-size: 1.2rem;
      color: var(--text-dim);
      margin-top: 1.5rem;
    }

    .business-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }

    .business-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 24px;
      padding: 2.5rem;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .business-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, var(--forest), var(--ocean), var(--coral));
      transform: scaleX(0);
      transition: transform 0.4s;
    }

    .business-card:hover::before {
      transform: scaleX(1);
    }

    .business-card::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: radial-gradient(circle, var(--ocean)10, transparent);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .business-card:hover::after {
      width: 500px;
      height: 500px;
    }

    .business-card:hover {
      transform: translateY(-10px) rotate(-1deg);
      border-color: var(--ocean);
      box-shadow: 0 20px 60px rgba(0, 119, 190, 0.3);
    }

    .business-icon {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      display: block;
      position: relative;
      z-index: 1;
      transition: transform 0.4s;
    }

    .business-card:hover .business-icon {
      transform: scale(1.2) rotate(10deg);
    }

    .business-card h3 {
      font-size: 1.8rem;
      margin-bottom: 1rem;
      color: var(--text);
      position: relative;
      z-index: 1;
    }

    .business-card p {
      color: var(--text-dim);
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
      line-height: 1.7;
    }

    .business-link {
      color: var(--coral);
      text-decoration: none;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: gap 0.3s;
      position: relative;
      z-index: 1;
    }

    .business-link:hover {
      gap: 1rem;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;
    }

    .project-card {
      background: var(--bg-light);
      border: 2px solid var(--border);
      border-radius: 24px;
      padding: 2.5rem;
      transition: all 0.4s;
      position: relative;
      overflow: hidden;
    }

    .project-card::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(135deg, var(--forest), var(--ocean), var(--coral));
      border-radius: 24px;
      opacity: 0;
      transition: opacity 0.4s;
      z-index: -1;
