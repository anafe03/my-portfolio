---
// src/pages/intelligence.astro — "What Is AI?" interactive explainer
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="An interactive, ground-up explainer of how AI actually works — tokens, embeddings, attention, agents — and what Austin Nafe builds with it.">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta property="og:type" content="website">
  <meta property="og:title" content="What Is AI? — how AI works & what I build">
  <meta property="og:description" content="Tokens to agents to production, then the energy wall and what comes after silicon. An interactive explainer.">
  <meta property="og:image" content="/profile.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <title>What Is AI? — how AI works, and what I build</title>
  <style is:global>
  :root {
    --ink: #070b1e; --bg: #0a0e27; --surface: #121a38; --surface-2: #1a2346;
    --border: #29325c; --border-bright: #3c4a86;
    --text: #eaf0fb; --text-dim: #96a2c4; --text-mute: #5d6b95;
    --ocean: #4aa7ec; --ocean-soft: #7bc0f5; --ocean-deep: #0077be;
    --coral: #ff7070; --green: #3ddc97; --amber: #f6c667; --violet: #b48cf0;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", "Cascadia Code", Menlo, Monaco, monospace;
    --rail-w: 246px; --maxw: 940px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background:
      radial-gradient(1200px 700px at 78% -8%, rgba(74,167,236,0.10), transparent 60%),
      radial-gradient(900px 600px at 8% 12%, rgba(255,112,112,0.06), transparent 55%),
      var(--bg);
    color: var(--text); font-family: var(--sans); font-size: 17px; line-height: 1.65;
    -webkit-font-smoothing: antialiased; letter-spacing: 0.005em;
  }
  ::selection { background: rgba(74,167,236,0.32); color: #fff; }
  a { color: var(--ocean); text-decoration: none; }
  a:hover { color: var(--ocean-soft); }
  :focus-visible { outline: 2px solid var(--ocean); outline-offset: 3px; border-radius: 3px; }

  .shell { display: flex; }
  .rail {
    position: sticky; top: 0; align-self: flex-start; width: var(--rail-w); height: 100vh; flex-shrink: 0;
    padding: 28px 20px; border-right: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(7,11,30,0.7), rgba(7,11,30,0.2)); backdrop-filter: blur(6px);
    display: flex; flex-direction: column; gap: 3px; z-index: 20;
  }
  .rail-brand { font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); }
  .rail-brand b { color: var(--text); font-weight: 700; letter-spacing: 0.02em; display:block; font-size: 15px; text-transform: none; margin-top: 3px;}
  .rail-brand i { color: var(--text-mute); font-style: normal; font-size: 10.5px; letter-spacing: 0.04em; display:block; margin-top:2px; }
  .rail-list { list-style: none; margin-top: 15px; display: flex; flex-direction: column; gap: 0px; overflow-y: auto; }
  .rail-item {
    display: flex; align-items: baseline; gap: 10px; font-family: var(--mono); font-size: 12.5px; color: var(--text-mute);
    padding: 6px 9px; border-radius: 7px; cursor: pointer; transition: color .2s, background .2s;
    border: 1px solid transparent; width: 100%; text-align: left; background: none;
  }
  .rail-item:hover { color: var(--text-dim); background: rgba(255,255,255,0.03); }
  .rail-item .rn { color: var(--text-mute); font-size: 10.5px; width: 16px; flex-shrink: 0; transition: color .2s; }
  .rail-item.active { color: var(--text); background: rgba(74,167,236,0.10); border-color: rgba(74,167,236,0.28); }
  .rail-item.active .rn { color: var(--ocean); }
  .rail-item.done .rn { color: var(--green); }
  .rail-foot { margin-top: auto; font-family: var(--mono); font-size: 10.5px; color: var(--text-mute); line-height: 1.55; padding-top: 12px; }

  main { flex: 1; min-width: 0; }
  .panel {
    min-height: 100vh; padding: 88px clamp(24px, 6vw, 92px);
    display: flex; flex-direction: column; justify-content: center; border-bottom: 1px solid var(--border); position: relative;
  }
  .panel-inner { width: 100%; max-width: var(--maxw); margin: 0 auto; }

  .eyebrow {
    font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.17em; text-transform: uppercase; color: var(--ocean);
    display: flex; align-items: center; gap: 10px; margin-bottom: 20px;
  }
  .eyebrow::before { content: ""; width: 26px; height: 1px; background: var(--ocean); opacity: .6; }
  .eyebrow .rung-tag { color: var(--text-mute); }

  h1 { font-size: clamp(2.3rem, 5.6vw, 4.2rem); line-height: 1.03; font-weight: 800; letter-spacing: -0.025em; text-wrap: balance; }
  h2 { font-size: clamp(1.85rem, 4vw, 2.9rem); line-height: 1.07; font-weight: 800; letter-spacing: -0.022em; text-wrap: balance; }
  h3 { font-size: 1.16rem; font-weight: 700; letter-spacing: -0.01em; }
  .lede { font-size: clamp(1.05rem, 1.8vw, 1.28rem); color: var(--text-dim); max-width: 62ch; margin-top: 20px; line-height: 1.6; }
  .lede strong, p.body strong { color: var(--text); font-weight: 600; }
  p.body { color: var(--text-dim); max-width: 64ch; margin-top: 16px; }
  em { color: var(--text); font-style: italic; }
  .accent-ocean { color: var(--ocean-soft); } .accent-coral { color: var(--coral); }
  .accent-green { color: var(--green); } .accent-amber { color: var(--amber); } .accent-violet { color: var(--violet); }

  .beats { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 36px; }
  .beats.stack { grid-template-columns: 1fr; }
  .card {
    background: linear-gradient(180deg, var(--surface), var(--surface) 40%, rgba(18,26,56,0.65));
    border: 1px solid var(--border); border-radius: 14px; padding: 22px; position: relative; overflow: hidden;
  }
  .card-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); margin-bottom: 13px; display: flex; align-items: center; gap: 8px; }
  .card-label .dot { width: 7px; height: 7px; border-radius: 50%; }
  .dot.ocean { background: var(--ocean); box-shadow: 0 0 10px var(--ocean); }
  .dot.coral { background: var(--coral); box-shadow: 0 0 10px var(--coral); }
  .dot.green { background: var(--green); box-shadow: 0 0 10px var(--green); }
  .dot.violet{ background: var(--violet); box-shadow: 0 0 10px var(--violet); }
  .dot.amber { background: var(--amber); box-shadow: 0 0 10px var(--amber); }
  .card h3 { margin-bottom: 8px; } .card p { color: var(--text-dim); font-size: 0.96rem; }

  pre {
    font-family: var(--mono); font-size: 13px; line-height: 1.7; background: var(--ink); border: 1px solid var(--border);
    border-radius: 12px; padding: 16px 18px; overflow-x: auto; color: #cdd6f0;
  }
  pre .cm { color: var(--text-mute); font-style: italic; } pre .kw { color: #c79bf0; } pre .fn { color: var(--ocean-soft); }
  pre .st { color: var(--green); } pre .nm { color: var(--amber); } pre .op { color: var(--text-dim); }
  .code-cap { font-family: var(--mono); font-size: 11px; color: var(--text-mute); margin-top: 9px; }

  .biz { border-left: 2px solid var(--coral); padding: 4px 0 4px 20px; margin-top: 26px; }
  .biz .proj { font-family: var(--mono); font-size: 12px; letter-spacing: 0.05em; color: var(--coral); text-transform: uppercase; margin-bottom: 8px; }
  .biz p { color: var(--text-dim); font-size: 0.98rem; } .biz .val { color: var(--text); font-weight: 600; }

  .diagram { margin-top: 14px; display: flex; flex-direction: column; gap: 12px; }
  .flowrow { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .node { font-family: var(--mono); font-size: 12.5px; padding: 9px 13px; border-radius: 9px; border: 1px solid var(--border-bright); background: var(--surface-2); color: var(--text); white-space: nowrap; }
  .node.model { border-color: var(--ocean); color: var(--ocean-soft); }
  .node.tool  { border-color: var(--amber); color: var(--amber); }
  .node.out   { border-color: var(--coral); color: var(--coral); }
  .node.data  { border-color: var(--green); color: var(--green); }
  .arrow { color: var(--text-mute); font-family: var(--mono); font-size: 15px; }

  /* what you're seeing caption */
  .seeing { font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); line-height: 1.65; margin-top: 14px; padding: 12px 15px; border: 1px dashed var(--border); border-radius: 10px; background: rgba(255,255,255,0.015); }
  .seeing b { color: var(--ocean-soft); font-weight: 600; }

  /* under-the-hood depth toggle (study mode) */
  .uth { margin-top: 14px; border: 1px solid var(--border); border-radius: 10px; background: rgba(255,255,255,0.015); overflow: hidden; }
  .uth > summary { cursor: pointer; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ocean-soft); padding: 12px 15px; list-style: none; display: flex; align-items: center; gap: 9px; }
  .uth > summary::-webkit-details-marker { display: none; }
  .uth > summary::before { content: "▸"; color: var(--text-mute); transition: transform .2s; }
  .uth[open] > summary::before { transform: rotate(90deg); }
  .uth .uth-body { padding: 2px 15px 15px; font-size: 0.93rem; color: var(--text-dim); line-height: 1.6; }
  .uth .m { font-family: var(--mono); color: var(--ocean-soft); background: var(--ink); padding: 1px 6px; border-radius: 5px; font-size: 0.85em; }
  .uth b { color: var(--text); font-weight: 600; }

  .btn { font-family: var(--mono); font-size: 13px; letter-spacing: 0.03em; padding: 11px 18px; border-radius: 10px; border: 1px solid var(--border-bright); color: var(--text); cursor: pointer; transition: all .2s; background: rgba(255,255,255,0.02); display:inline-flex; align-items:center; gap:8px; }
  .btn.primary { background: linear-gradient(180deg, var(--ocean), var(--ocean-deep)); border-color: var(--ocean); color: #fff; font-weight: 600; }
  .btn.primary:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .btn:hover { border-color: var(--ocean); color: #fff; }
  .btn.sm { padding: 7px 12px; font-size: 12px; }
  .ctrl-row { display:flex; gap:9px; flex-wrap:wrap; align-items:center; margin-top:16px; }

  /* ---------- HERO ---------- */
  #hero { justify-content: center; min-height: 100vh; padding-top: 56px; }
  .hero-kicker { font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 24px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .hero-kicker .live { display:inline-flex; align-items:center; gap:7px; color: var(--green); }
  .hero-kicker .live::before { content:""; width:8px; height:8px; border-radius:50%; background:var(--green); box-shadow:0 0 10px var(--green); animation: pulse 2.4s infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.45;transform:scale(.82)} }
  .hero h1 .grad { background: linear-gradient(100deg, var(--ocean) 10%, var(--ocean-soft) 45%, var(--coral) 95%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .hero .lede { font-size: clamp(1.08rem,2vw,1.36rem); max-width: 60ch; }
  .hero-cta { margin-top: 40px; display: flex; gap: 13px; flex-wrap: wrap; align-items: center; }
  .scroll-hint { margin-top: 44px; font-family: var(--mono); font-size: 12px; color: var(--text-mute); letter-spacing:0.06em; display:flex; align-items:center; gap:10px; }
  .scroll-hint .k { border:1px solid var(--border-bright); border-radius:5px; padding:2px 7px; color: var(--text-dim); }

  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.3,1), transform .7s cubic-bezier(.2,.7,.3,1); }
  .reveal.in { opacity: 1; transform: none; }

  /* ---------- TERM MAP ---------- */
  .termmap { margin-top: 30px; display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; align-items: stretch; }
  .nest { position: relative; border-radius: 16px; padding: 18px; border: 1px solid var(--border-bright); font-family: var(--mono); }
  .nest .nlabel { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 10px; }
  .nest.l1 { background: rgba(74,167,236,0.05); }
  .nest.l2 { background: rgba(74,167,236,0.07); border-color: var(--ocean); }
  .nest.l3 { background: rgba(123,192,245,0.09); border-color: var(--ocean-soft); }
  .nest.l4 { background: rgba(61,220,151,0.10); border-color: var(--green); }
  .nest.l4 .nlabel { color: var(--green); }
  .nest.l4 .ndesc { color: var(--text); }
  .ndesc { font-family: var(--sans); font-size: 0.9rem; color: var(--text-dim); }
  .uses { display: flex; flex-direction: column; gap: 10px; }
  .use { border: 1px solid var(--border); border-radius: 11px; padding: 13px 15px; background: var(--surface); }
  .use b { font-family: var(--mono); font-size: 12px; letter-spacing: 0.03em; }
  .use.prompt b { color: var(--ocean-soft); } .use.rag b { color: var(--green); }
  .use.tune b { color: var(--amber); } .use.agent b { color: var(--coral); }
  .use p { font-size: 0.88rem; color: var(--text-dim); margin-top: 3px; }

  /* ---------- TOKENS ---------- */
  .anim-stage { margin-top: 26px; background: var(--ink); border: 1px solid var(--border); border-radius: 16px; padding: 26px; }
  .tok-line { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; min-height: 60px; }
  .tok-chip {
    font-family: var(--mono); font-size: 15px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-bright);
    background: var(--surface-2); color: var(--text); opacity: 0; transform: translateY(8px) scale(.96);
    transition: opacity .3s, transform .3s; white-space: pre;
  }
  .tok-chip.in { opacity: 1; transform: none; }
  .tok-chip .tid { font-size: 10px; color: var(--text-mute); margin-left: 7px; }
  .tok-chip .sp { color: var(--text-mute); }
  .tok-chip:nth-child(4n+1) { border-color: var(--ocean); } .tok-chip:nth-child(4n+2) { border-color: var(--green); }
  .tok-chip:nth-child(4n+3) { border-color: var(--amber); } .tok-chip:nth-child(4n+4) { border-color: var(--coral); }
  .tok-count { font-family: var(--mono); font-size: 12px; color: var(--text-dim); margin-top: 16px; }
  .tok-count b { color: var(--amber); }

  /* ---------- EMBEDDINGS ---------- */
  .emb-wrap { margin-top: 26px; display: grid; grid-template-columns: 1.15fr .85fr; gap: 22px; align-items: start; }
  .emb-stage { position: relative; background: var(--ink); border: 1px solid var(--border); border-radius: 16px; height: 430px; overflow: hidden; }
  .emb-grid-line { position:absolute; background: rgba(255,255,255,0.03); }
  .emb-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .emb-dot {
    position: absolute; transform: translate(-50%,-50%); font-family: var(--mono); font-size: 12px; padding: 5px 9px;
    border-radius: 7px; border: 1px solid var(--border-bright); background: var(--surface-2); color: var(--text-dim);
    cursor: pointer; transition: left 1.1s cubic-bezier(.2,.8,.3,1), top 1.1s cubic-bezier(.2,.8,.3,1), color .2s, border-color .2s, box-shadow .2s, background .2s;
    white-space: nowrap; left: 50%; top: 50%;
  }
  .emb-dot.g-animal { --gc: var(--ocean); } .emb-dot.g-royal { --gc: var(--violet); }
  .emb-dot.g-food { --gc: var(--amber); } .emb-dot.g-tech { --gc: var(--green); }
  .emb-dot.g-query { --gc: var(--coral); }
  .emb-dot.placed { color: var(--gc); border-color: var(--gc); }
  .emb-dot.hot { color: #fff; background: var(--gc); border-color: var(--gc); box-shadow: 0 0 0 3px color-mix(in srgb, var(--gc) 25%, transparent); z-index: 5; }
  .emb-dot.dim { opacity: .28; }
  .emb-side { display: flex; flex-direction: column; gap: 14px; }
  .emb-legend { display: flex; flex-wrap: wrap; gap: 10px 16px; font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); }
  .emb-legend span { display: flex; align-items: center; gap: 6px; }
  .emb-legend i { width: 9px; height: 9px; border-radius: 3px; display:inline-block; }

  /* ---------- ATTENTION ---------- */
  .att-stage { margin-top: 26px; background: var(--ink); border: 1px solid var(--border); border-radius: 16px; padding: 30px 26px; }
  .att-sentence { font-family: var(--mono); font-size: clamp(15px, 2.4vw, 21px); line-height: 2.1; display: flex; flex-wrap: wrap; gap: 4px; }
  .att-word {
    padding: 4px 8px; border-radius: 7px; cursor: pointer; transition: background .35s, color .35s, box-shadow .2s;
    color: var(--text-dim); border: 1px solid transparent; position: relative;
  }
  .att-word:hover { box-shadow: inset 0 -2px 0 var(--border-bright); }
  .att-word.focus { color: #fff; border-color: var(--coral); background: rgba(255,112,112,0.16); }
  .att-word.lit { color: var(--text); }
  .att-hint { font-family: var(--mono); font-size: 12px; color: var(--text-mute); margin-top: 18px; }

  /* ---------- interactive agent loop ---------- */
  .loop-wrap { margin-top: 30px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 24px; align-items: start; }
  .loop-stage { background: var(--ink); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
  .loop-steps { display: flex; flex-direction: column; gap: 10px; }
  .lstep { display: flex; gap: 13px; align-items: flex-start; padding: 12px 14px; border-radius: 11px; border: 1px solid var(--border); background: var(--surface); opacity: .4; transition: opacity .35s, border-color .35s, background .35s, transform .35s; }
  .lstep.on { opacity: 1; border-color: var(--ocean); background: var(--surface-2); transform: translateX(4px); }
  .lstep.past { opacity: .7; }
  .lstep .ix { font-family: var(--mono); font-size: 12px; color: var(--ocean); border:1px solid var(--border-bright); border-radius:7px; width:26px;height:26px; display:flex;align-items:center;justify-content:center; flex-shrink:0; }
  .lstep.on .ix { background: var(--ocean); color:#fff; border-color: var(--ocean); }
  .lstep .ls-t { font-weight: 600; font-size: 0.96rem; } .lstep .ls-d { font-family: var(--mono); font-size: 12px; color: var(--text-dim); margin-top: 3px; }
  .loop-side { display: flex; flex-direction: column; gap: 16px; }
  .state-box { background: var(--surface); border:1px solid var(--border); border-radius: 12px; padding: 15px 17px; font-family: var(--mono); font-size: 12.5px; }
  .state-box .row { display:flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px dashed var(--border); }
  .state-box .row:last-child { border: none; } .state-box .sk { color: var(--text-mute); } .state-box .sv { color: var(--ocean-soft); }
  .mono-note { font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); line-height: 1.7; } .mono-note b { color: var(--text); }

  /* ---------- archetypes ---------- */
  .arch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap: 18px; margin-top: 34px; }
  .arch { background: var(--surface); border:1px solid var(--border); border-radius: 14px; padding: 22px; transition: border-color .25s, transform .25s; }
  .arch:hover { border-color: var(--border-bright); transform: translateY(-3px); }
  .arch .ak { font-family: var(--mono); font-size: 11px; letter-spacing:0.1em; text-transform: uppercase; color: var(--ocean); }
  .arch h3 { margin: 9px 0 8px; } .arch p { color: var(--text-dim); font-size: 0.94rem; }
  .arch .built { margin-top: 13px; font-family: var(--mono); font-size: 12px; color: var(--text-mute); border-top: 1px dashed var(--border); padding-top: 11px; }
  .arch .built b { color: var(--coral); font-weight: 600; }

  /* ---------- trace ---------- */
  .trace { margin-top: 28px; background: var(--ink); border: 1px solid var(--border); border-radius: 16px; padding: 22px; font-family: var(--mono); font-size: 13px; overflow-x: auto; }
  .trace-head { display:flex; justify-content: space-between; align-items:center; margin-bottom: 14px; color: var(--text-mute); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; } .trace-head .tot { color: var(--text-dim); }
  .tnode { display:flex; align-items:center; gap: 12px; padding: 8px 10px; border-radius: 8px; transition: background .2s; border:1px solid transparent; }
  .tnode:hover { background: rgba(255,255,255,0.03); border-color: var(--border); }
  .tnode .tw { width: 8px; height: 8px; border-radius: 2px; flex-shrink:0; }
  .tw.llm { background: var(--ocean); } .tw.tool { background: var(--amber); } .tw.ret { background: var(--green); } .tw.fail { background: var(--coral); }
  .tnode .tlabel { flex:1; color: var(--text); } .tnode .tlabel .tk { color: var(--text-mute); }
  .tnode .tms { color: var(--text-dim); } .tnode .ttok { color: var(--amber); width: 74px; text-align:right; }
  .tindent { margin-left: 26px; border-left: 1px dashed var(--border); padding-left: 12px; }
  .trace-legend { display:flex; gap:18px; margin-top:16px; flex-wrap:wrap; font-size:11.5px; color:var(--text-dim); } .trace-legend span { display:flex; align-items:center; gap:7px; } .trace-legend i { width:9px;height:9px;border-radius:2px; display:inline-block; }

  #close { text-align: center; } #close .panel-inner { display:flex; flex-direction: column; align-items: center; }
