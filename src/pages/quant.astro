  addEventListener('keydown', function(e){ if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return; var i=cur(); if(['ArrowDown','ArrowRight','PageDown'].indexOf(e.key)>-1){ e.preventDefault(); if(i<panels.length-1) panels[i+1].scrollIntoView({behavior:reduce?'auto':'smooth'}); } else if(['ArrowUp','ArrowLeft','PageUp'].indexOf(e.key)>-1){ e.preventDefault(); if(i>0) panels[i-1].scrollIntoView({behavior:reduce?'auto':'smooth'}); } });
