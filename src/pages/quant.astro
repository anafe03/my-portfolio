  function railFor(r){ return items.find(function(b){ return b.getAttribute('data-goto')===r; }); }
  var ao=new IntersectionObserver(function(es){ es.forEach(function(e){ if(!e.isIntersecting) return; var rung=e.target.getAttribute('data-rung'); var idx=order.indexOf(rung); items.forEach(function(b){ b.classList.remove('active'); var bi=order.indexOf(b.getAttribute('data-goto')); if(bi>-1&&bi<idx) b.classList.add('done'); else b.classList.remove('done'); }); var c=railFor(rung); if(c) c.classList.add('active'); }); }, { threshold: 0.5 });
