---
// src/layouts/Writing.astro — shared shell for /writing and its posts. Midnight tokens, Inter only.
import Analytics from '../components/Analytics.astro';

const { title, description, path } = Astro.props;
const url = `https://www.austinnafe.com${path}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="theme-color" content="#0a0e27">

  <meta property="og:type" content="article">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content="https://www.austinnafe.com/profile.jpg">
  <meta name="twitter:card" content="summary">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --ocean: #0077be;
      --coral: #ff6b6b;
      --bg: #0a0e27;
      --bg-light: #1a1f3a;
      --bg-card: #252b4a;
      --text: #e8eef7;
      --text-dim: #8b95b0;
      --border: #2d3557;
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      font-family: var(--font);
      background:
        radial-gradient(700px 420px at 50% -120px, rgba(0, 119, 190, 0.22), transparent 70%),
        var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100dvh;
      -webkit-font-smoothing: antialiased;
      padding: max(28px, env(safe-area-inset-top)) 16px max(48px, env(safe-area-inset-bottom));
    }
    a { color: inherit; text-decoration: none; }
    :focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; border-radius: 8px; }

    .wrap { max-width: 680px; margin: 0 auto; }
    .top { display: flex; justify-content: space-between; font-size: 14px; color: var(--text-dim); margin-bottom: 40px; }
    .top a:hover { color: var(--text); }
    .foot { text-align: center; color: var(--text-dim); font-size: 12px; margin-top: 64px; }

    @media (min-width: 720px) { body { padding-top: 56px; } }
  </style>
</head>
<body>
  <main class="wrap">
    <nav class="top" aria-label="Site">
      <a href="/">Austin Nafe</a>
      <a href="/writing">Writing</a>
    </nav>
    <slot />
    <p class="foot">austinnafe.com</p>
  </main>
  <Analytics />
</body>
</html>
