---
// Traffic + performance instrumentation, in one place.
//
// Uses Vercel's official Astro components (@vercel/analytics, @vercel/speed-insights).
// Both are cookieless and collect no personal data, so no consent banner is required.
// Both must also be enabled in the Vercel dashboard: Project → Analytics → Enable, and
// Project → Speed Insights → Enable.
//
// The events block is progressive enhancement. It records which links a visitor actually
// used and how far down a page they read. It no-ops if the analytics script is blocked or
// disabled, so it can never break a page.
// aliased: a bare `Analytics` import collides with this file's own component name
import VercelAnalytics from '@vercel/analytics/astro';
import VercelSpeedInsights from '@vercel/speed-insights/astro';

const { events = true } = Astro.props;
---
<VercelAnalytics />
<VercelSpeedInsights />

{events && (
  <script is:inline>
    (function () {
      // window.va is Vercel's event queue, installed by the analytics script above.
      function track(name, data) {
        try { if (typeof window.va === 'function') window.va('event', { name: name, data: data || {} }); }
        catch (e) { /* never let instrumentation break the page */ }
      }

      // 1. Outbound and asset clicks: which proof did they actually open?
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a || !a.href) return;
        var href = a.getAttribute('href') || '';
        if (href.endsWith('.pdf')) return track('resume_open', { href: href });
        if (/^mailto:/.test(href)) return track('email_click', {});
        if (/^https?:/.test(href) && a.host !== location.host) {
          track('outbound', { host: a.host, href: href.slice(0, 120) });
        }
      }, { passive: true });

      // 2. Read depth: a case study nobody scrolls is a case study nobody read.
      var marks = [25, 50, 75, 100], fired = {};
      function onScroll() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        if (max <= 0) return;
        var pct = (h.scrollTop / max) * 100;
        for (var i = 0; i < marks.length; i++) {
          var m = marks[i];
          if (pct >= m && !fired[m]) {
            fired[m] = true;
            track('read_depth', { page: location.pathname, depth: m });
          }
        }
      }
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
)}
